<div
    id="map"
    data-controller="order-map"
    data-order-map-pickup-lat-value="<%= @pickup_lat %>"
    data-order-map-pickup-lon-value="<%= @pickup_lon %>"
    data-order-map-delivery-lat-value="<%= @delivery_lat %>"
    data-order-map-delivery-lon-value="<%= @delivery_lon %>"
    data-order-map-ors-api-key-value="<%= @ors_api_key %>"
    style="height: 400px; border-radius: 12px;"
    class="mb-4">
</div>
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
