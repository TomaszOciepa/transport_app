<div class="container my-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">
            Zamówienie <span class="text-primary">#<%= @order.order_number %></span>
        </h2>
        <small class="text-muted">Utworzono: <%= l(@order.created_at, format: :long) %></small>
    </div>

    <!-- Actions -->
    <div class="mb-4 d-flex gap-2">
        <%= link_to edit_dispatcher_order_path(@order), class: "btn btn-outline-secondary btn-sm p-2 shadow-sm rounded-pill" do %>
        <i class="bi bi-pencil"></i> Edytuj
        <% end %>

        <%= link_to dispatcher_order_path(@order),
      data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć zamówienie?" },
      class: "btn btn-outline-danger btn-sm p-2 shadow-sm rounded-pill" do %>
        <i class="bi bi-trash"></i> Usuń
        <% end %>
    </div>

    <!-- Szczegóły zamówienia -->
    <div class="card pastel-box pastel-box-blue p-4 mb-4">
        <h5 class="mb-3 border-bottom pb-2"><i class="bi bi-info-circle me-2"></i>Szczegóły zamówienia</h5>
        <div class="row">
            <div class="col-md-6 mb-2">
                <p><strong>Status:</strong>
                    <span class="badge status-badge <%= @order.current_status %> rounded-pill px-3 py-1">
                        <%= @order.status_name || "Brak statusu" %>
                    </span>
                </p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Wymagany pojazd:</strong> <%= @order.vehicle_type.name %></p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Data załadunku:</strong> <%= l(@order.pickup_date, format: :long) if @order.pickup_date %></p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Data dostawy:</strong> <%= l(@order.delivery_date, format: :long) if @order.delivery_date %></p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Adres załadunku:</strong> <%= @order.pickup_address %></p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Adres dostawy:</strong> <%= @order.delivery_address %></p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Czas przejazdu:</strong> <%= @order.travel_time&.round(2) %> h</p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Odległość:</strong> <%= number_with_precision(@order.distance_km, precision: 2) %> km</p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Typ usługi:</strong> <%= @order.service_type.name %></p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Klient:</strong> <%= @order.user.email %></p>
            </div>
            <div class="col-md-6 mb-2">
                <p><strong>Cena:</strong> <%= number_to_currency(@order.price, unit: "PLN ", precision: 2) %></p>
            </div>
        </div>
    </div>

    <!-- Order Progress -->
    <div class="card pastel-box pastel-box-green p-4 mb-4">
        <h5 class="mb-3 border-bottom pb-2"><i class="bi bi-list-task me-2"></i>Postęp zamówienia</h5>

        <ul class="timeline list-unstyled position-relative m-0 p-0">

            <!-- Vehicle Assignment -->
            <% vehicle = @order.current_vehicle %>
            <% vehicle_assigned = vehicle.present? %>
            <% vehicle_has_driver = vehicle_assigned && vehicle.vehicle_drivers.exists?(current: true) %>

            <li class="timeline-item mb-5 position-relative ps-4">
                <span class="timeline-line position-absolute start-0 top-0 bottom-0 border-start border-2" style="left: 15px;"></span>

                <%# Icon: red, yellow or green %>
                <span class="timeline-dot position-absolute rounded-circle" style="left: 7px; width: 16px; height: 16px; background-color: 
      <%= if !vehicle_assigned
            '#dc3545'  # no vehicle - red
          elsif vehicle_has_driver
            '#28a745' # assigned vehicle with driver – green
          else
            '#ffc107'  # assigned driverless vehicle – yellow
          end %>;">
                </span>

                <div class="timeline-content position-relative">
                    <h6 class="mb-2 fw-bold">Przypisanie pojazdu</h6>

                    <% if !vehicle_assigned %>
                    <p class="text-muted fst-italic">Brak przypisanego pojazdu</p>

                    <% elsif vehicle_has_driver %>
                    <p>Aktualnie przypisany pojazd:
                        <%= link_to "#{vehicle.brand} - #{vehicle.registration_number}",
                    dispatcher_vehicle_path(vehicle),
                    class: "text-decoration-underline fw-semibold" %>
                    </p>

                    <% current_order_vehicle = @order.order_vehicles.find_by(vehicle: vehicle, current: true) %>
                    <% if current_order_vehicle %>
                    <small class="position-absolute top-0 end-0 text-muted text-end" style="font-size: 0.75rem;">
                        <%= l(current_order_vehicle.updated_at, format: :short) %><br>
                        <%= current_order_vehicle.user&.email || "system" %>
                    </small>
                    <% end %>
                    <% else %>
                    <p>Aktualnie przypisany pojazd:
                        <%= link_to "#{vehicle.brand} - #{vehicle.registration_number}",
                    dispatcher_vehicle_path(vehicle),
                    class: "text-decoration-underline fw-semibold" %>
                    </p>
                    <p class="text-warning fst-italic">
                        Pojazd nie ma przypisanego kierowcy.
                    </p>

                    <% current_order_vehicle = @order.order_vehicles.find_by(vehicle: vehicle, current: true) %>
                    <% if current_order_vehicle %>
                    <small class="position-absolute top-0 end-0 text-muted text-end" style="font-size: 0.75rem;">
                        <%= l(current_order_vehicle.updated_at, format: :short) %><br>
                        <%= current_order_vehicle.user&.email || "system" %>
                    </small>
                    <% end %>
                    <% end %>
                    <div class="mt-2 d-flex gap-2">
                        <% current_order_vehicle = @order.order_vehicles.find_by(current: true) %>

                        <%= link_to suggest_dispatcher_order_order_vehicles_path(@order),
      class: "ios-fab-btn",
      title: (current_order_vehicle ? "Zmień pojazd" : "Dodaj pojazd") do %>
                        <i class="bi bi-plus-lg"></i>
                        <i class="bi bi-truck me-1"></i>
                        <%= current_order_vehicle ? "Zmień pojazd" : "Pojazd" %>
                        <% end %>
                        <%= link_to dispatcher_order_order_vehicles_path(@order),
                  class: "ios-fab-btn", title: "Historia pojazdu" do %>
                        <i class="bi bi-clock-history me-1"></i> Historia
                        <% end %>
                    </div>
                </div>
            </li>



            <!-- Pickup -->
            <li class="timeline-item mb-5 position-relative ps-4">
                <span class="timeline-line position-absolute start-0 top-0 bottom-0 border-start border-2" style="left: 15px;"></span>
                <span class="timeline-dot position-absolute rounded-circle" style="left: 7px; width: 16px; height: 16px;
              background-color: <%= @order.pickup_date.present? && @order.pickup_date <= Time.current ? '#28a745' : '#dc3545' %>;"></span>
                <div class="timeline-content position-relative">
                    <h6 class="mb-2 fw-bold">Odbiór</h6>
                    <% if @order.pickup_date.present? && @order.pickup_address.present? %>
                    <small class="position-absolute top-0 end-0 text-muted text-end" style="font-size: 0.75rem;">
                        <%= l(@order.created_at, format: :long) %><br>
                        <%= "system" %>
                    </small>
                    <p>Data: <%= l(@order.pickup_date, format: :long) %><br>Lokalizacja: <%= @order.pickup_address %></p>
                    <% else %>
                    <p class="text-muted fst-italic">Brak informacji o odbiorze</p>
                    <% end %>
                </div>
            </li>

            <!-- In progres -->
            <li class="timeline-item mb-5 position-relative ps-4">
                <span class="timeline-line position-absolute start-0 top-0 bottom-0 border-start border-2" style="left: 15px;"></span>
                <span class="timeline-dot position-absolute rounded-circle" style="left: 7px; width: 16px; height: 16px;
              background-color: <%= @order.pickup_date.present? && @order.pickup_date <= Time.current + 10.minutes ? '#28a745' : '#dc3545' %>;"></span>
                <div class="timeline-content position-relative">
                    <h6 class="mb-2 fw-bold">W drodze</h6>
                    <% if @order.travel_time.present? && @order.travel_time.present? %>
                    <small class="position-absolute top-0 end-0 text-muted text-end" style="font-size: 0.75rem;">
                        <%= l(@order.created_at, format: :long) %><br>
                        <%= "system" %>
                    </small>
                    <p>Przewidywany czas dostawy około <%= @order.travel_time&.round(2) %> h</p>
                    <% else %>
                    <p class="text-muted fst-italic">Brak informacji o czasie dostawy</p>
                    <% end %>
                </div>
            </li>

            <!-- Delivery -->
            <li class="timeline-item mb-5 position-relative ps-4">
                <span class="timeline-line position-absolute start-0 top-0 bottom-0 border-start border-2" style="left: 15px;"></span>
                <span class="timeline-dot position-absolute rounded-circle" style="left: 7px; width: 16px; height: 16px;
              background-color: <%= @order.delivery_date.present? && @order.delivery_date <= Time.current ? '#28a745' : '#dc3545' %>;"></span>
                <div class="timeline-content position-relative">
                    <h6 class="mb-2 fw-bold">Dostawa</h6>
                    <% if @order.delivery_date.present? && @order.delivery_address.present? %>
                    <small class="position-absolute top-0 end-0 text-muted text-end" style="font-size: 0.75rem;">
                        <%= l(@order.created_at, format: :long) %><br>
                        <%= "system" %>
                    </small>
                    <p>Data: <%= l(@order.delivery_date, format: :long) %><br>Lokalizacja: <%= @order.delivery_address %></p>
                    <% else %>
                    <p class="text-muted fst-italic">Brak informacji o dostawie</p>
                    <% end %>
                </div>
            </li>

        </ul>
    </div>



    <!-- Mapa -->
    <div class="card pastel-box pastel-box-pink p-3 mb-4">
        <h5 class="mb-3"><i class="bi bi-geo-alt me-2"></i>Mapa realizacji</h5>
        <div class="map-container" style="width: 100%; max-width: 900px; height: 400px; margin: 0 auto;">
            <%= render(MapComponent.new(
        pickup_lat: @order.pickup_lat,
        pickup_lon: @order.pickup_lon,
        delivery_lat: @order.delivery_lat,
        delivery_lon: @order.delivery_lon
      )) %>
        </div>
    </div>


    <!-- WhatsApp Chat Section -->
    <div class="card pastel-box pastel-box-light p-3 mb-4">
        <h5 class="mb-3 border-bottom pb-2"><i class="bi bi-chat-left-text me-2"></i>Grupa WhatsApp</h5>

        <% if @order.current_order_vehicle&.whatsapp_group %>
        <% group = @order.current_order_vehicle.whatsapp_group %>
        <p><strong>Nazwa grupy:</strong> <%= group.name %></p>
        <p><strong>Członkowie:</strong>
            Kierowca:
            <% driver = group.order_vehicle.vehicle.current_driver %>
            <%= driver ? link_to("#{driver.first_name} #{driver.last_name}", dispatcher_driver_path(driver)) : "Brak" %>,
            Bot: System
        </p>



        <div class="chat-messages border rounded p-2 mb-3" style="height: 300px; overflow-y: auto; background-color: #f7f7f7;">
            <% @messages.each do |msg| %>
            <div class="d-flex flex-column mb-2 <%= msg.is_from_driver ? 'align-items-start' : 'align-items-end' %>">
                <div class="p-2 rounded" style="background-color: <%= msg.is_from_driver ? '#e1ffc7' : '#d1e7ff' %>;">
                    <strong>
                        <%= if msg.is_from_driver
                                driver = @order.current_order_vehicle&.vehicle&.current_driver
                                driver ? "#{driver.first_name} #{driver.last_name}" : "Kierowca"
                            else
                                "Dispatcher"
                            end %>:
                    </strong>
                    <%= msg.body %>

                </div>
                <small class="text-muted"><%= l msg.timestamp, format: :short %></small>
            </div>
            <% end %>
        </div>

        <!-- Form to send new message -->
        <%= form_with url: send_whatsapp_dispatcher_order_path(@order), method: :post, local: true, html: { class: "d-flex gap-2" } do |f| %>
        <%= f.text_area :body, placeholder: "Napisz wiadomość...", class: "form-control", rows: 1, style: "resize: none;" %>
        <%= f.hidden_field :group_id, value: group.whatsapp_group_id %>
        <%= f.submit "Wyślij", class: "btn btn-primary" %>
        <% end %>

        <% else %>
        <p class="text-warning fst-italic">Nie utworzono jeszcze grupy WhatsApp dla tego pojazdu.</p>
        <% end %>
    </div>




    <!-- Back -->
    <div class="mt-4">
        <%= link_to dispatcher_orders_path, class: "ios-back-btn ios-btn-back mt-3" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót
        <% end %>
    </div>
</div>