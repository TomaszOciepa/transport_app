<div class="table-responsive shadow-sm rounded-4 pastel-table">
    <table class="table table-hover mb-0 align-middle">
        <thead class="pastel-thead">
            <tr>
                <th class="text-center">Lp</th>
                <th><%= sortable "status", "Status" %></th>
                <th><%= sortable "pickup_date", "Data zał-roz" %></th>
                <th><%= sortable "pickup_address", "Miejsce zał-roz" %></th>
                <th><%= sortable "pickup_address", "Pojazd" %></th>
                <th><%= sortable "vehicle_type_id", "Typ pojazdu" %></th>
                <th><%= sortable "order_number", "Nr zamówienia" %></th>
                <th><%= sortable "service_type_id", "Usługa" %></th>
                <th>Akcje</th>
            </tr>
        </thead>

        <tbody>
            <% @orders.each_with_index do |order, index| %>
            <tr>
                <td class="text-center text-muted"><%= index + 1 %></td>
                <td>
                    <% status = order.current_status %>
                    <span class="badge status-badge <%= status %> rounded-pill px-3 py-2 fw-semibold">
                        <%= order.status_name %>
                    </span>
                </td>
                <td><%= l(order.pickup_date, format: :short) if order.pickup_date %> - <%= l(order.delivery_date, format: :short) if order.delivery_date %></td>
                <td><%= order.pickup_place %> - <%= order.delivery_place %></td>
                <td>
                    <% if order.current_vehicle %>
                    <%= link_to order.current_vehicle&.registration_number, dispatcher_vehicle_path(order.current_vehicle),
                            class: "text-decoration-underline fw-semibold" %>
                    <% else %>
                    <span class="text-muted fst-italic">Brak</span>
                    <% end %>
                </td>
                <td class="text-center">
                    <% case order.vehicle_type.name %>
                    <% when "Bus" %>
                    <i class="bi bi-bus-front fs-4 text-primary" title="Bus"></i>
                    <% when "Ciężarówka solo" %>
                    <i class="bi bi-truck fs-4 text-warning" title="Ciężarówka solo"></i>
                    <% when "Ciężarówka z naczepą" %>
                    <i class="bi bi-truck-flatbed fs-4 text-danger" title="Ciężarówka z naczepą"></i>
                    <% when "Samochód osobowy" %>
                    <i class="bi bi-car-front fs-4 text-success" title="Samochód osobowy"></i>
                    <% else %>
                    <i class="bi bi-question-circle fs-4 text-muted" title="Nieznany typ"></i>
                    <% end %>
                </td>
                <td class="fw-bold text-dark"><%= order.order_number %></td>
                <td><%= order.service_type.name %></td>
                <td>
                    <div class="d-flex gap-2">
                        <%= link_to dispatcher_order_path(order),
                class: "btn btn-icon btn-pastel-secondary shadow-sm rounded-circle",
                title: "Szczegóły" do %>
                        <i class="bi bi-gear"></i>
                        <% end %>

                        <%= link_to dispatcher_order_path(order),
                data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć to zamówienie?" },
                class: "btn btn-icon btn-pastel-danger shadow-sm rounded-circle",
                title: "Usuń" do %>
                        <i class="bi bi-trash"></i>
                        <% end %>
                    </div>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table>
</div>