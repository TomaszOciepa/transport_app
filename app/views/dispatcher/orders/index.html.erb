<div class="container-fluid py-5">
    <!-- Header -->
    <div <div class="d-flex flex-column mb-4">
        <h2 class="fw-bold mb-2"><%= @page_title %></h2>
        <%= render "orders_menu" %>
    </div>

    <div class="row g-4">
        <!-- Left Column: Suggestions -->
        <div class="col-lg-6">
            <%= render "app_suggestions" %>
        </div>

        <!-- Right column: Statistics -->
        <div class="col-lg-6">
            <h4 class="fw-bold mb-3">📊 Statystyki</h4>

            <div class="row g-3">
            <div class="col-6">
              <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card bg-blue">
                <i class="bi bi-list-check fs-2 text-white mb-2"></i>
                <h6 class="fw-semibold text-white mb-1">Wszystkie</h6>
                <p class="fs-5 fw-bold text-white mb-0"><%= @total_orders %></p>
              </div>
            </div>
          
            <div class="col-6">
              <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card bg-yellow">
                <i class="bi bi-clock-history fs-2 text-white mb-2"></i>
                <h6 class="fw-semibold text-white mb-1">Oczekujące</h6>
                <p class="fs-5 fw-bold text-white mb-0"><%= @pending_orders %></p>
              </div>
            </div>
          
            <div class="col-6">
              <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card bg-green">
                <i class="bi bi-calendar-check fs-2 text-white mb-2"></i>
                <h6 class="fw-semibold text-white mb-1">Zaplanowane</h6>
                <p class="fs-5 fw-bold text-white mb-0"><%= @planned_orders %></p>
              </div>
            </div>
          
            <div class="col-6">
              <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card bg-pink">
                <i class="bi bi-truck fs-2 text-white mb-2"></i>
                <h6 class="fw-semibold text-white mb-1">W drodze</h6>
                <p class="fs-5 fw-bold text-white mb-0"><%= @in_progress_orders %></p>
              </div>
            </div>
          
            <div class="col-12">
              <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card bg-purple">
                <i class="bi bi-check2-circle fs-2 text-white mb-2"></i>
                <h6 class="fw-semibold text-white mb-1">Zakończone</h6>
                <p class="fs-5 fw-bold text-white mb-0"><%= @completed_orders %></p>
              </div>
            </div>
          </div>
          
        </div>
    </div>
</div>