<div class="container-fluid py-5">
    <!-- Nagłówek -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-2" style="color: #2c2c2c;">📊 Pulpit zamówień</h2>
        <%= render "orders_menu" %>
    </div>

    <div class="row g-4">
        <!-- Lewa kolumna: Sugestie -->
        <div class="col-lg-6">
            <h4 class="fw-bold mb-3" style="color: #2c2c2c;">🧭 Centrum sugestii</h4>

            <!-- Sekcja sugestii -->
            <div class="d-flex flex-column gap-3">

                <% if @pending_orders > 0 %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #FFF6E5;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Zamówienia oczekujące</h6>
                            <p class="text-muted small mb-2">
                                Masz <strong><%= @pending_orders %></strong> zamówień oczekujących na zaplanowanie.
                            </p>
                            <%= link_to "Zaplanuj teraz", pending_orders_dispatcher_orders_path, class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold" %>
                        </div>
                    </div>
                </div>
                <% else %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #E9FBEF;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Świetna robota!</h6>
                            <p class="text-muted small mb-0">
                                Wszystkie zamówienia są zaplanowane. Jesteś na bieżąco ze wszystkim 💪
                            </p>
                        </div>
                    </div>
                </div>
                <% end %>

                <% if @in_progress_orders > 0 %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #E8F5FF;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-truck fs-3 text-primary"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">W drodze</h6>
                            <p class="text-muted small mb-0">
                                Obecnie <strong><%= @in_progress_orders %></strong> zamówień jest w realizacji. Monitoruj ich status.
                            </p>
                        </div>
                    </div>
                </div>
                <% end %>

                <% if @completed_orders > 0 %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #F3E8FF;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-check2-circle fs-3 text-success"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Zakończone zamówienia</h6>
                            <p class="text-muted small mb-0">
                                Dostarczono już <strong><%= @completed_orders %></strong> zamówień. Sprawdź historię, jeśli potrzebujesz raportu.
                            </p>
                        </div>
                    </div>
                </div>
                <% end %>

                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #F8FAFC;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-lightbulb-fill fs-3 text-info"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Wskazówka</h6>
                            <p class="text-muted small mb-0">
                                Regularne aktualizowanie statusów zamówień ułatwi planowanie kolejnych transportów.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Prawa kolumna: Statystyki -->
        <div class="col-lg-6">
            <h4 class="fw-bold mb-3" style="color: #2c2c2c;">📦 Statystyki</h4>

            <div class="row g-3">
                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #9AD0EC;">
                        <i class="bi bi-list-check fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">Wszystkie</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @total_orders %></p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #FFD6A5;">
                        <i class="bi bi-clock-history fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">Oczekujące</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @pending_orders %></p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #B5EAD7;">
                        <i class="bi bi-calendar-check fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">Zaplanowane</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @planned_orders %></p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #FFB7B2;">
                        <i class="bi bi-truck fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">W drodze</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @in_progress_orders %></p>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #E2C1F0;">
                        <i class="bi bi-check2-circle fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">Zakończone</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @completed_orders %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styl -->
<style>
    .stat-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    }
</style>