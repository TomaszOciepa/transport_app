<h4 class="suggestions-header fw-bold mb-3 d-flex justify-content-between align-items-center px-1">
  <span class="d-flex align-items-center gap-2">
    <span class="suggestions-header__icon">🧭</span>
    <span class="suggestions-header__title">
      Checklist <span class="suggestions-header__accent">– Suggestions</span>
    </span>
  </span>

  <% total_order_tasks = @orders_needing_attention.size %>
  <% if total_order_tasks > 0 %>
    <span class="badge suggestions-badge rounded-pill px-3 py-2 shadow-sm">
      <%= total_order_tasks %> zadań
    </span>
  <% end %>
</h4>

<div class="suggestions-container d-flex flex-column gap-3">
  <% if @orders_needing_attention.any? %>

    <% @orders_needing_attention.each do |order| %>
      <% vehicle = order.current_order_vehicle&.vehicle %>
      <% has_vehicle = vehicle.present? %>
      <% driver = has_vehicle ? vehicle.vehicle_drivers.find_by(current: true)&.driver : nil %>
      <% has_driver = driver.present? %>

      <% days_left_pickup = order.pickup_date.present? ? (order.pickup_date.to_date - Date.current).to_i : nil %>

      <% driver_days_left =
        if driver&.availabilities&.any?
          current_or_next = driver.availabilities.where("end_time >= ?", Time.current).order(:end_time).first
          current_or_next ? (current_or_next.end_time.to_date - Date.current).to_i : nil
        end
      %>

      <% suggestion_class =
        if !has_vehicle
          "suggestion--no-vehicle bg-danger-soft"
        elsif has_vehicle && !has_driver
          "suggestion--no-driver bg-warning-soft"
        elsif driver_days_left && driver_days_left < 7
          "suggestion--driver-expiring bg-warning-light"
        else
          "bg-white"
        end
      %>

      <div class="card suggestion-card shadow-sm rounded-4 border-0 p-4 <%= suggestion_class %>">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-exclamation-triangle-fill suggestion-icon"></i>

          <div>
            <h6 class="fw-bold mb-1 suggestion-title">
              <%= link_to dispatcher_order_path(order), class: "suggestion-link" do %>
                Zamówienie <%= order.order_number.presence || "brak numeru referencyjnego" %>
              <% end %>
            </h6>

            <% if !has_vehicle %>
              <p class="suggestion-text">
                To zamówienie <strong>nie ma przypisanego pojazdu</strong>.
                <% if days_left_pickup %><br>Odbiór za <strong><%= days_left_pickup %></strong> dni.<% end %>
              </p>

              <%= link_to "Przypisz pojazd",
                dispatcher_order_path(order),
                class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1"
              %>

            <% elsif has_vehicle && !has_driver %>
              <p class="suggestion-text">
                Pojazd <strong><%= vehicle.brand %> – <%= vehicle.registration_number %></strong>
                nie ma aktualnie przypisanego kierowcy.
                <% if days_left_pickup %><br>Odbiór za <strong><%= days_left_pickup %></strong> dni.<% end %>
              </p>

              <%= link_to "Zarządzaj pojazdem",
                dispatcher_vehicle_path(vehicle),
                class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1"
              %>

            <% elsif driver_days_left && driver_days_left < 7 %>
              <p class="suggestion-text">
                Kierowca <strong><%= driver.full_name %></strong> ma dostępność tylko przez kolejne
                <strong><%= driver_days_left %></strong> dni.
                <% if days_left_pickup %><br>Odbiór za <strong><%= days_left_pickup %></strong> dni.<% end %>
              </p>

              <%= link_to "Zarządzaj kierowcą",
                dispatcher_driver_path(driver),
                class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1"
              %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

  <% else %>

    <div class="card suggestion-card shadow-sm rounded-4 border-0 p-4 bg-success-soft">
      <div class="d-flex align-items-start gap-3">
        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
        <div>
          <h6 class="fw-bold mb-1 suggestion-title">Świetna robota!</h6>
          <p class="suggestion-text">
            Wszystkie zamówienia mają przypisane pojazdy i kierowców 🚛✨
          </p>
        </div>
      </div>
    </div>

  <% end %>
</div>
