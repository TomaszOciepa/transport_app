<div class="container-fluid mt-4">
    <div class="whatsapp-container">

        <!-- LEFT COLUMN: GROUP LIST -->
        <div class="whatsapp-sidebar">
            <div class="ws-header">
                <span>Grupy WhatsApp</span>
                <i class="bi bi-chat-dots fs-5"></i>
            </div>
            <div class="chat-list">
                <% active_driver = @order.current_order_vehicle&.vehicle&.current_driver %>
                <% active_group = active_driver ? WhatsappGroup.find_by(order_id: @order.id, driver_id: active_driver.id) : nil %>
                <% groups_raw = WhatsappGroup.where(order_id: @order.id).includes(:driver) %>
                <% groups = groups_raw.partition { |g| g == active_group }.flatten
                   .tap { |arr| arr[1..] = arr[1..].sort_by(&:created_at).reverse if arr.size > 1 } %>

                <% groups.each do |g| %>
                <% is_active = (g == active_group) %>
                <div class="chat-item <%= 'active' if is_active %>" data-group-id="<%= g.id %>" onclick="selectChat(this)">
                    <div class="chat-avatar"><%= g.driver.first_name.first %></div>
                    <div class="flex-grow-1">
                        <div class="fw-bold"><%= g.driver.first_name %> <%= g.driver.last_name %></div>
                        <div class="text-muted" style="font-size: 0.8rem;"><%= g.name %></div>
                    </div>
                    <small class="text-muted"><%= g.created_at.strftime("%d.%m") %></small>
                </div>
                <% end %>
            </div>
        </div>

        <!-- RIGHT COLUMN: CHAT AREA -->
        <div class="whatsapp-chat-area">
            <% if active_group.present? %>
            <% groups.each do |g| %>
            <% is_active = (g == active_group) %>
            <div class="chat-pane" id="chat-pane-<%= g.id %>" style="display: <%= is_active ? 'flex' : 'none' %>; flex-direction: column;">

                <!-- CHAT HEADER -->
                <div class="chat-header">
                    <div class="chat-avatar"><%= g.driver.first_name.first %></div>
                    <div>
                        <div class="fw-bold">
                            <%= link_to "#{g.driver.first_name} #{g.driver.last_name}", dispatcher_driver_path(g.driver), class: "text-decoration-none text-dark" %>
                        </div>
                        <div class="text-muted" style="font-size: 0.8rem;">
                            <%= link_to g.name, dispatcher_messages_path(group_id: g.id), class: "text-decoration-none text-muted" %>
                        </div>
                    </div>
                </div>

                <!-- CHAT MESSAGES -->
                <div class="chat-messages">
                    <% messages = g.whatsapp_messages.order(:timestamp) %>
                    <% if messages.any? %>
                    <% messages.each do |msg| %>
                    <div class="d-flex flex-column <%= msg.is_from_driver ? 'align-items-start' : 'align-items-end' %>">
                        <div class="bubble <%= msg.is_from_driver ? 'driver' : 'dispatcher' %>">
                            <div class="bubble-sender">
                                <%= msg.is_from_driver ? "#{g.driver.first_name} #{g.driver.last_name}" : "Dyspozytor" %>
                            </div>
                            <div class="bubble-text"><%= msg.body %></div>
                            <div class="bubble-time"><%= l msg.timestamp, format: :short %></div>
                        </div>
                    </div>
                    <% end %>
                    <% else %>
                    <div class="text-center text-muted fst-italic">Brak wiadomości w tej grupie.</div>
                    <% end %>
                </div>

                <!-- NOTICE: SENDING DISABLED -->
                <div class="p-3 text-center text-muted fst-italic border-top">
                    Wysyłanie wiadomości jest wyłączone w tym widoku.
                </div>
            </div>
            <% end %>
            <% else %>
            <div class="h-100 d-flex justify-content-center align-items-center text-muted">
                <div class="text-center">
                    <i class="bi bi-chat fs-1 text-muted"></i>
                    <p>Brak grup WhatsApp dla tego zamówienia.</p>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>

<script>
    function selectChat(el) {
        // active group on the left
        document.querySelectorAll('.chat-item').forEach(i => i.classList.remove('active'));
        el.classList.add('active');

        // hide all chats
        document.querySelectorAll('.chat-pane').forEach(pane => pane.style.display = 'none');

        // show selected chat
        const groupId = el.getAttribute('data-group-id');
        document.getElementById(`chat-pane-${groupId}`).style.display = 'flex';
    }
</script>