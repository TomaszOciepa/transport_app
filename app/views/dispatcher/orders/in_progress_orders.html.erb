<div class="container-fluid py-5">
    <div class="d-flex flex-column mb-4">

        <h2 class="fw-bold mb-2"><%= @page_title %></h2>

        <%= render "orders_menu" %>
    </div>

    <% if @orders.any? %>
    <%= render "orders_table" %>
    <% else %>
    <div class="alert alert-info rounded-3 shadow-sm mt-3">
        Brak zamówień.
    </div>
    <% end %>


</div>