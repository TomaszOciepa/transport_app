<div class="container my-4">
    <h3 class="mb-4">Historia przypisanych pojazdów dla kierowcy <%= @driver.full_name %></h3>

    <% if @vehicle_drivers.any? %>
    <div class="table-responsive shadow-sm rounded pastel-box p-3">
        <table class="table table-hover mb-0 align-middle">
            <thead class="pastel-thead">
                <tr>
                    <th>Pojazd</th>
                    <th>Obecny</th>
                    <th>Data przypisania</th>
                    <th>Przypisane przez</th>
                </tr>
            </thead>
            <tbody>
                <% @vehicle_drivers.each do |vd| %>
                <tr>
                    <td>
                        <%= link_to vd.vehicle.brand, dispatcher_vehicle_path(vd.vehicle), class: "text-decoration-underline fw-semibold" %>
                    </td>
                    <td>
                        <% if vd.current %>
                        <span class="badge status-badge completed rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-check-lg text-success"></i>
                        </span>
                        <% else %>
                        <span class="badge status-badge canceled rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-x-lg text-danger"></i>
                        </span>
                        <% end %>
                    </td>
                    <td>
                        <%= l(vd.created_at, format: :short) %> -
                        <%= vd.current ? "?" : l(vd.updated_at, format: :short) %>
                    </td>
                    <td><%= vd.user ? vd.user.email : "System" %></td>
                </tr>
                <% end %>
            </tbody>
        </table>
    </div>
    <% else %>
    <p class="text-muted">Ten kierowca nie ma jeszcze przypisanych pojazdów.</p>
    <% end %>

    <div class="mt-3">
        <%= link_to dispatcher_driver_path(@driver), class: "ios-back-btn ios-btn-back" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót do kierowcy
        <% end %>
    </div>
</div>