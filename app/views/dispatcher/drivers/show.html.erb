<div class="container my-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">
            Kierowca <span class="text-primary"><%= @driver.first_name %> <%= @driver.last_name %></span>
        </h2>
        <small class="text-muted">Utworzono: <%= l(@driver.created_at, format: :long) %></small>
    </div>

    <!-- Actions -->
    <div class="mb-4 d-flex gap-2">
        <%= link_to edit_dispatcher_driver_path(@driver), class: "ios-fab-btn", title: "Edytuj" do %>
        <i class="bi bi-pencil"></i> Edytuj
        <% end %>

        <%= link_to dispatcher_driver_path(@driver),
        data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć tego kierowcę?" },
        class: "ios-fab-btn", title: "Usuń" do %>
        <i class="bi bi-trash"></i> Usuń
        <% end %>
    </div>

    <!-- Dane kierowcy -->
    <div class="card pastel-box pastel-box-blue p-4 mb-4">
        <h5 class="mb-3 border-bottom pb-2"><i class="bi bi-person-circle me-2"></i>Dane kierowcy</h5>

        <div class="row">
            <div class="col-md-6 mb-2">
                <p><strong>Status:</strong>
                    <% status_class = case @driver.current_status
            when "available" then "bg-success text-white"
            when "busy" then "bg-primary text-white"
            when "unavailable" then "bg-danger text-white"
            else "bg-light text-dark"
          end %>
                    <span class="badge <%= status_class %> rounded-pill px-3 py-1">
                        <%= @driver.current_status_i18n %>
                    </span>
                </p>
            </div>

            <div class="col-md-6 mb-2">
                <p><strong>Email:</strong> <%= @driver.email %></p>
            </div>

            <div class="col-md-6 mb-2">
                <p><strong>Telefon:</strong> <%= @driver.phone %></p>
            </div>

            <div class="col-md-6 mb-2">
                <p><strong>Kategoria prawa jazdy:</strong> <%= @driver.license_category.name %></p>
            </div>

            <div class="col-md-6 mb-2">
                <p><strong>Rok urodzenia:</strong> <%= @driver.birth_year %></p>
            </div>
        </div>
    </div>

    <ul class="timeline list-unstyled position-relative m-0 p-0">
        <% current_assignment = @driver.vehicle_drivers.find_by(current: true) %>
        <% vehicle = current_assignment&.vehicle %>
        <% vehicle_assigned = vehicle.present? %>

        <li class="timeline-item mb-5 position-relative ps-4">
            <span class="timeline-line position-absolute start-0 top-0 bottom-0 border-start border-2" style="left: 15px;"></span>

            <%# 🔵 Kolorowa kropka w zależności od przypisania %>
            <span class="timeline-dot position-absolute rounded-circle" style="left: 7px; width: 16px; height: 16px; background-color:
          <%= vehicle_assigned ? '#28a745' : '#dc3545' %>;">
            </span>

            <div class="timeline-content position-relative">
                <h6 class="mb-2 fw-bold">
                    <i class="bi bi-truck me-2"></i>Aktualnie przypisany pojazd
                </h6>

                <% if vehicle_assigned %>
                <p>Aktualnie przypisany pojazd:
                    <%= link_to "#{vehicle.brand} - #{vehicle.registration_number}",
                      dispatcher_vehicle_path(vehicle),
                      class: "text-decoration-underline fw-semibold" %>
                </p>

                <% if current_assignment %>
                <small class="position-absolute top-0 end-0 text-muted text-end" style="font-size: 0.75rem;">
                    <%= l(current_assignment.updated_at, format: :short) %><br>
                    <%= current_assignment.user&.email || "system" %>
                </small>
                <% end %>
                <% else %>
                <p class="text-muted fst-italic">
                    Kierowca nie ma aktualnie przypisanego pojazdu.
                </p>
                <% end %>

                <div class="mt-2 d-flex gap-2">

                    <%= link_to driver_history_dispatcher_driver_path(@driver),
            class: "ios-fab-btn", title: "Historia przypisań pojazdów" do %>
                    <i class="bi bi-clock-history me-1"></i> Historia
                    <% end %>

                </div>
            </div>
        </li>
    </ul>


    <!-- Dostępność kierowcy -->
    <div class="card pastel-box pastel-box-green p-4 mb-4">
        <h5 class="mb-3 border-bottom pb-2 d-flex justify-content-between align-items-center">
            <span><i class="bi bi-calendar2-check me-2"></i>Dostępność kierowcy</span>
            <%= link_to new_dispatcher_availability_path(
            availableable_id: @driver.id,
            availableable_type: "Driver"
          ),
          class: "ios-fab-btn", title: "Dodaj dostępność" do %>
            <i class="bi bi-plus-lg me-1"></i> Dodaj
            <% end %>
        </h5>

        <% if @driver.availabilities.any? %>
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover mb-0 align-middle">
                <thead class="pastel-thead">
                    <tr>
                        <th>Od</th>
                        <th>Do</th>
                        <th class="text-center">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    <% @availabilities.each do |availability| %>

                    <tr>
                        <td><%= l(availability.start_time, format: :short) %></td>
                        <td><%= l(availability.end_time, format: :short) %></td>
                        <td class="text-center">
                            <%= link_to edit_dispatcher_availability_path(
                        availability,
                        availableable_id: @driver.id,
                        availableable_type: "Driver"
                      ),
                      class: "ios-fab-btn btn-sm me-1 mb-1",
                      title: "Edytuj dostępność" do %>
                            <i class="bi bi-pencil"></i>
                            <% end %>

                            <%= link_to dispatcher_availability_path(availability,
                      availableable_id: @driver.id,
                      availableable_type: "Driver"),
                    data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć tę dostępność?" },
                    class: "ios-fab-btn btn-sm mb-1",
                    title: "Usuń dostępność" do %>
                            <i class="bi bi-trash"></i>
                            <% end %>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
        <% else %>
        <p class="text-muted fst-italic">Brak dostępności dla tego kierowcy.</p>
        <% end %>
    </div>

    <div class="mt-3">
        <%= link_to dispatcher_drivers_path, class: "ios-back-btn ios-btn-back" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót do listy
        <% end %>
    </div>

</div>