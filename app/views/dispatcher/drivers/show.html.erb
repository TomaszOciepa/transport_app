<div class="container my-4">
  <h2 class="fw-bold mb-2">
    Kierowca <span class="text-primary"><%= @driver.first_name %> <%= @driver.last_name %></span>
  </h2>
  <small class="text-muted mb-4 d-block">
    Utworzono: <%= l(@driver.created_at, format: :long) %>
  </small>

  <div class="card shadow-sm rounded-4 p-4 position-relative mb-4">
    <div class="position-absolute top-0 end-0 m-3 d-flex gap-2">
      <%= link_to edit_dispatcher_driver_path(@driver), class: "btn btn-outline-secondary btn-sm p-2", title: "Edytuj" do %>
        <i class="bi bi-pencil"></i>
      <% end %>

      <%= link_to dispatcher_driver_path(@driver),
            data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć tego kierowcę?" },
            class: "btn btn-outline-secondary btn-sm p-2",
            title: "Usuń" do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>

    <h5 class="mb-3 border-bottom pb-2"><i class="bi bi-person-circle me-2"></i>Dane kierowcy</h5>

    <div class="row mb-3">
          <div class="col-md-6 mb-2">
            <p><strong>Status:</strong>
              <% status_class = case @driver.current_status
                when "available" then "bg-success text-white"
                when "busy" then "bg-primary text-white"
                when "off_duty" then "bg-danger text-white"
                else "bg-light text-dark"
              end %>
              <span class="badge <%= status_class %> rounded-pill px-3 py-1">
                <%= @driver.current_status_i18n %>
              </span>
            </p>
          </div>


      <div class="col-md-6 mb-2">
        <p><strong>Email:</strong> <%= @driver.email %></p>
      </div>

      <div class="col-md-6 mb-2">
        <p><strong>Telefon:</strong> <%= @driver.phone %></p>
      </div>

      <div class="col-md-6 mb-2">
        <p><strong>Kategoria prawa jazdy:</strong> <%= @driver.license_category.name %></p>
      </div>

      <div class="col-md-6 mb-2">
        <p><strong>Rok urodzenia:</strong> <%= @driver.birth_year %></p>
      </div>
    </div>
  </div>

<!-- card for available -->
  <div class="card shadow-sm rounded-4 p-4 mt-4">
  <h5 class="mb-3 border-bottom pb-2 d-flex justify-content-between align-items-center">
    <span><i class="bi bi-calendar2-check me-2"></i>Dostępność kierowcy</span>
    <%= link_to new_dispatcher_availability_path(
          availableable_id: @driver.id,
          availableable_type: "Driver"
        ),
        class: "btn btn-outline-secondary btn-sm p-2",
        title: "Dodaj dostępność" do %>
      <i class="bi bi-calendar2-check me-2 text-secondary"></i> Dodaj
    <% end %>
  </h5>

  <% if @driver.availabilities.any? %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Od</th>
          <th>Do</th>
          <th class="text-center">Akcje</th>
        </tr>
      </thead>
      <tbody>
        <% @driver.availabilities.each do |availability| %>
          <tr>
            <td><%= l(availability.start_time, format: :short) %></td>
            <td><%= l(availability.end_time, format: :short) %></td>
            <td class="text-center">
              <%= link_to edit_dispatcher_availability_path(
                    availability,
                    availableable_id: @driver.id,
                    availableable_type: "Driver"
                  ),
                  class: "btn btn-outline-secondary btn-sm p-2",
                  title: "Edytuj dostępność" do %>
                <i class="bi bi-pencil"></i>
              <% end %>

            <%= link_to dispatcher_availability_path(availability,
                availableable_id: @driver.id,
                availableable_type: "Driver"),
            data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć tę dostępność?" },
            class: "btn btn-outline-secondary btn-sm p-2",
            title: "Usuń dostępność" do %>
  <i class="bi bi-trash"></i>
<% end %>



            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted">Brak dostępności dla tego kierowcy.</p>
  <% end %>
</div>


  <div class="mt-3">
    <%= link_to "Powrót do listy", dispatcher_drivers_path, class: "btn btn-dark rounded-pill px-4 py-2 shadow-sm" %>
  </div>
</div>
