<div class="container my-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">
                <div class="mb-4 d-flex gap-2">
        <%= link_to edit_dispatcher_driver_path(@driver), class: "ios-fab-btn", title: "Edytuj" do %>
        <i class="bi bi-pencil"></i> Edytuj
        <% end %>

        <%= link_to dispatcher_driver_path(@driver),
        data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć tego kierowcę?" },
        class: "ios-fab-btn", title: "Usuń" do %>
        <i class="bi bi-trash"></i> Usuń
        <% end %>
    </div>
        </h2>
        <small class="text-muted">Utworzono: <%= l(@driver.created_at, format: :long) %></small>
    </div>

    

    <!-- Dane kierowcy -->
    <div class="card shadow-sm rounded-4 p-4 mb-4 driver-profile-card">

                <!-- HEADER PROFILU -->
                <div class="d-flex align-items-center mb-4">

                    <div class="driver-avatar me-4">
                    <%= image_tag "men_icon.png", class: "driver-avatar-img" %>
                    </div>

                    <div class="flex-grow-1">
                    <h4 class="mb-1 fw-bold">
                        <%= @driver.first_name %> <%= @driver.last_name %>
                    </h4>

                    <div class="text-muted small">
                        Kierowca <%= @driver.license_category.name %>
                    </div>
                    </div>

                    <div class="text-end small">
                    <div><strong>Status:</strong>
                        <% status_class = case @driver.current_status
                        when "available" then "bg-success"
                        when "busy" then "bg-primary"
                        when "unavailable" then "bg-danger"
                        else "bg-secondary"
                        end %>
                        <span class="badge <%= status_class %> rounded-pill px-3 py-1">
                        <%= @driver.current_status_i18n %>
                        </span>
                    </div>
                    </div>

                </div>

                <div class="row">

                    <!-- LEWA KOLUMNA -->
                    <div class="col-md-6 border-end pe-4">

                    <h6 class="text-muted mb-3">Informacje osobiste</h6>

                    <div class="driver-info-row">
                        <span>Narodowość</span>
                        <strong>Polska</strong>
                    </div>
                    
                    <div class="driver-info-row">
                        <span>Stan cywilny</span>
                        <strong>Żonaty</strong>
                    </div>

                    <div class="driver-info-row">
                        <span>Rok urodzenia</span>
                        <strong>07-08-<%= @driver.birth_year %></strong>
                    </div>

                    <div class="driver-info-row">
                        <span>Adres zamieszkania</span>
                        <strong>80-288 Gdańsk, ul. Myśliwskie Wzgórze 2/33</strong>
                    </div>

                </div>

            <!-- PRAWA KOLUMNA -->
            <div class="col-md-6 ps-4">

            <h6 class="text-muted mb-3">Pozostałe informacje</h6>
                
                <div class="driver-info-row">
                    <span>Telefon</span>
                    <strong><%= @driver.phone %></strong>
                </div>

                <div class="driver-info-row">
                    <span>Email</span>
                    <strong><%= @driver.email %></strong>
                </div>

            <div class="driver-info-row">
                <span>Kategoria prawa jazdy</span>
                <strong><%= @driver.license_category.name %></strong>
            </div>


            </div>

        </div>

    </div>


    <!--  przypisany pojazd -->
   
    <div class="card shadow-sm rounded-4 p-4 mb-4 driver-section-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="section-title">
            <i class="bi bi-truck me-2"></i>Przypisany pojazd
            </h6>

            <%= link_to driver_history_dispatcher_driver_path(@driver),
                class: "btn btn-sm btn-light border" do %>
            <i class="bi bi-clock-history me-1"></i> Historia
            <% end %>
        </div>

        <% current_assignment = @driver.vehicle_drivers.find_by(current: true) %>
        <% vehicle = current_assignment&.vehicle %>

        <% if vehicle.present? %>

            <div class="row align-items-center">
            <div class="col-md-8">
                <div class="info-row">
                <span>Pojazd</span>
                <strong>
                    <%= link_to "#{vehicle.brand} — #{vehicle.registration_number}",
                        dispatcher_vehicle_path(vehicle),
                        class: "text-decoration-none" %>
                </strong>
                </div>

                <div class="info-row">
                <span>Przypisano</span>
                <strong><%= l(current_assignment.updated_at, format: :long) %></strong>
                </div>
            </div>

            </div>

        <% else %>

            <div class="text-muted fst-italic">
            Kierowca nie ma przypisanego pojazdu.
            </div>

        <% end %>
        </div>



   <!-- Dostępność kierowcy -->
<div class="card shadow-sm rounded-4 p-4 mb-4 driver-section-card">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="section-title">
      <i class="bi bi-calendar2-check me-2"></i>Dostępność kierowcy
    </h6>

    <%= link_to new_dispatcher_availability_path(
          availableable_id: @driver.id,
          availableable_type: "Driver"
        ),
        class: "btn btn-sm btn-light border" do %>
      <i class="bi bi-plus-lg me-1"></i> Dodaj
    <% end %>
  </div>

  <% if @availabilities.any? %>
    <div class="availability-list">

      <% @availabilities
            .sort_by(&:start_time).reverse
            .group_by { |a| I18n.l(a.start_time, format: "%B %Y") }
            .each do |month, avails| %>

        <!-- 🔹 Separator miesiąca -->
        <div class="month-separator">
          <span><%= month %></span>
        </div>

        <!-- 🔹 Dostępności w tym miesiącu -->
        <% avails.each do |availability| %>
          <div class="availability-row">

            <div class="availability-dates">
              <strong><%= l(availability.start_time, format: :long) %></strong>
              <div class="text-muted small">do</div>
              <strong><%= l(availability.end_time, format: :long) %></strong>
            </div>

            <div class="d-flex gap-2">
              <%= link_to edit_dispatcher_availability_path(
                    availability,
                    availableable_id: @driver.id,
                    availableable_type: "Driver"
                  ),
                  class: "btn btn-sm btn-light border" do %>
                <i class="bi bi-pencil"></i>
              <% end %>

              <%= link_to dispatcher_availability_path(
                    availability,
                    availableable_id: @driver.id,
                    availableable_type: "Driver"
                  ),
                  data: { turbo_method: :delete, turbo_confirm: "Usunąć dostępność?" },
                  class: "btn btn-sm btn-light border" do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </div>

          </div>
        <% end %>

      <% end %>

    </div>
  <% else %>
    <div class="text-muted fst-italic">Brak dostępności</div>
  <% end %>

</div>



    <div class="mt-3">
        <%= link_to dispatcher_drivers_path, class: "ios-back-btn ios-btn-back" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót do listy
        <% end %>
    </div>

</div>