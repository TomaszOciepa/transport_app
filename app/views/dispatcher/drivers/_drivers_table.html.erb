<div data-controller="drivers-search">
    <div class="card p-3 mb-3 shadow-sm">

    <input type="text"
            class="form-control"
            placeholder="Szukaj po imieniu, nazwisku, telefonie, pojeździe, statusie..."
            data-drivers-search-target="input"
            data-action="input->drivers-search#filter">
    </div>

        <div class="table-responsive shadow-sm rounded-4 pastel-box p-3">
            <table class="table table-hover mb-0 align-middle">
                <thead class="pastel-thead">
                    <tr>
                        <th class="text-center">Lp</th>
                        <th><%= sortable "first_name", "Imię" %></th>
                        <th><%= sortable "last_name", "Nazwisko" %></th>
                        <th><%= sortable "email", "Email" %></th>
                        <th>Telefon</th>
                        <th><%= sortable "license_category_id", "Prawo jazdy" %></th>
                        <th>Pojazd</th>
                        <th><%= sortable "status", "Status" %></th>
                        <th>Akcje</th>
                    </tr>
                </thead>

                <tbody data-drivers-search-target="rows">
                    <% @drivers.each_with_index do |driver, index| %>
                    <tr>
                        <td class="text-center text-muted"><%= index + 1 %></td>
                        <td><%= driver.first_name %></td>
                        <td><%= driver.last_name %></td>
                        <td><%= driver.email %></td>
                        <td><%= driver.phone %></td>
                        <td><%= driver.license_category.name %></td>

                        <!-- NOWA KOLUMNA: Aktualny pojazd -->
                        <td>
                            <% if driver.current_vehicles.any? %>
                            <% vehicle = driver.current_vehicles.first %>
                            <%= link_to dispatcher_vehicle_path(vehicle),
                        class: "text-decoration-underline fw-semibold" do %>
                            <%= vehicle.brand %>
                            <% end %>
                            <% else %>
                            <span class="text-muted fst-italic">Brak przypisania</span>
                            <% end %>
                        </td>

                        <td>
                            <% status_class = case driver.current_status
                    when "available" then "status-badge completed"
                    when "busy" then "status-badge in_progress"
                    when "unavailable" then "status-badge canceled"
                    else "status-badge pending"
                end %>
                            <span class="<%= status_class %> rounded-pill px-3 py-1 fw-semibold">
                                <%= driver.current_status_i18n %>
                            </span>
                        </td>

                        <td>
                            <%= link_to dispatcher_driver_path(driver),
                            class: "btn btn-icon btn-pastel-secondary shadow-sm rounded-circle",
                                title: "Szczegóły" do %>
                            <i class="bi bi-gear"></i>
                            <% end %>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
</div>    