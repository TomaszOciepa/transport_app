<div class="mb-4">
    <%= f.label :vehicle_id, "Pojazd", class: "form-label fw-semibold" %>

    <% if selected_vehicle %>
    <%= f.hidden_field :vehicle_id, value: selected_vehicle.id %>
    <div class="p-2 rounded-3 pastel-box-ios fw-semibold text-dark shadow-sm">
        <i class="bi bi-car-front-fill me-2 text-primary"></i>
        <%= selected_vehicle.brand %> - <%= selected_vehicle.registration_number %>
    </div>
    <% else %>
    <%= f.select :vehicle_id,
        vehicles.map { |v| ["#{v.brand} - #{v.registration_number}", v.id] },
        { prompt: "Wybierz pojazd" },
        class: "form-select ios-select pastel-select shadow-sm" %>
    <% end %>
</div>