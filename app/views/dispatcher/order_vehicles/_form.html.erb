<div class="container my-4">
    <h3 class="mb-4"> <%= title %> #<%= @order.order_number %> </h3>

    <% if @vehicles.any? %>
    <div class="pastel-box p-4">
        <%= form_with(model: [@order, @order_vehicle], url: dispatcher_order_order_vehicles_path(@order), local: true) do |f| %>

        <div class="mb-4">
            <%= f.label :vehicle_id, "Wybierz pojazd", class: "form-label fw-semibold" %>
            <%= f.select :vehicle_id,
            @vehicles.map { |v| ["#{v.brand} - #{v.registration_number}", v.id] },
            { prompt: "Wybierz pojazd" },
            class: "form-select ios-select" %>
        </div>

        <%= link_to dispatcher_order_path(@order), class: "ios-back-btn ios-btn-back mt-3" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót do zamówienia
        <% end %>
        <%= f.submit "Zapisz", class: "ios-btn ios-btn-save mb-0" %>

        <% end %>
    </div>
    <% else %>
    <div class="static-warning mt-4 p-3 rounded-3">
        <div class="d-flex align-items-start">
            <div class="me-3">
                <i class="bi bi-truck fs-2 text-warning"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Brak dostępnych pojazdów</h6>
                <p class="mb-0 text-muted small">
                    Żaden pojazd nie jest obecnie dostępny w wybranym okresie.
                    Zmień daty zamówienia lub sprawdź grafik dostępności pojazdów.
                </p>
            </div>
        </div>

        <%= link_to dispatcher_order_path(@order), class: "ios-back-btn ios-btn-back mt-3" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót do zamówienia
        <% end %>
    </div>
    <% end %>
</div>