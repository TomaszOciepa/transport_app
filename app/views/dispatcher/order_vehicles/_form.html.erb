<div class="container my-4">
    <h3><%= title %> #<%= @order.order_number %></h3>

    <% if @vehicles.any? %>
    <%= form_with(model: [@order, @order_vehicle], url: dispatcher_order_order_vehicles_path(@order), local: true) do |f| %>
    <div class="mb-3">
        <%= f.label :vehicle_id, "Wybierz pojazd" %>
        <%= f.select :vehicle_id,
          @vehicles.map { |v| ["#{v.brand} - #{v.registration_number}", v.id] },
          { prompt: "Wybierz pojazd" },
          class: "form-select" %>
    </div>

    <%= f.submit "Zapisz", class: "btn btn-primary" %>
    <% end %>
    <% else %>
    <div class="static-warning mt-4 p-3 rounded-3">
        <div class="d-flex align-items-start">
            <div class="me-3">
                <i class="bi bi-truck fs-2 text-warning"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Brak dostępnych pojazdów</h6>
                <p class="mb-0 text-muted small">
                    Żaden pojazd nie jest obecnie dostępny w wybranym okresie.
                    Zmień daty zamówienia lub sprawdź grafik dostępności pojazdów.
                </p>
            </div>
        </div>
    </div>

    <%= link_to "Powrót do zamówienia", dispatcher_order_path(@order), class: "btn btn-secondary mt-3" %>
    <% end %>
</div>