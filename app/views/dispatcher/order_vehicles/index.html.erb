<div class="container my-4">
    <h3>Historia przypisań pojazdów – Zamówienie #<%= @order.order_number %></h3>

    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <th>Pojazd</th>
                <th>Przypisany przez</th>
                <th>Data przypisania / zmiany</th>
                <th>Aktualny?</th>
            </tr>
        </thead>
        <tbody>
            <% @order_vehicles.each do |ov| %>
            <tr>
                <td>
                    <%= link_to "#{ov.vehicle.brand} - #{ov.vehicle.registration_number}", 
              dispatcher_vehicle_path(ov.vehicle), 
              class: "text-decoration-underline" %>
                </td>
                <td><%= ov.user ? ov.user.email : "System" %></td>
                <td><%= l(ov.updated_at, format: :long) %></td>
                <td>
                    <% if ov.current %>
                    <span class="badge bg-success">Aktualny</span>
                    <% else %>
                    <span class="badge bg-secondary">Nieaktualny</span>
                    <% end %>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table>

    <div class="mt-3">
        <%= link_to "Powrót do zamówienia", dispatcher_order_path(@order), class: "btn btn-dark" %>
    </div>
</div>