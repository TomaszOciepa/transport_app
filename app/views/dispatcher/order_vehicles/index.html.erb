<div class="container my-4">
    <h3 class="mb-4">Historia przypisań pojazdów dla zamówienia #<%= @order.order_number %></h3>

    <% if @order_vehicles.any? %>
    <div class="table-responsive shadow-sm rounded pastel-box p-3">
        <table class="table table-hover mb-0 align-middle">
            <thead class="pastel-thead">
                <tr>
                    <th>Pojazd</th>
                    <th>Data zmiany</th>
                    <th>Zmienione przez</th>
                    <th>Aktualny</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                <% @order_vehicles.each do |ov| %>
                <tr>
                    <td>
                        <%= link_to "#{ov.vehicle.brand} - #{ov.vehicle.registration_number}", dispatcher_vehicle_path(ov.vehicle), class: "text-decoration-underline fw-semibold" %>
                    </td>
                    <td><%= l(ov.updated_at, format: :long) %></td>
                    <td><%= ov.user ? ov.user.email : "System" %></td>
                    <td>
                        <% if ov.current %>
                        <span class="status-badge completed rounded-pill px-3 py-1">Aktualny</span>
                        <% else %>
                        <span class="status-badge canceled rounded-pill px-3 py-1">Poprzedni</span>
                        <% end %>
                    </td>
                    <td>
                        <% if ov.current %>
                        <%= link_to "🗑️", unset_current_dispatcher_order_order_vehicle_path(@order, ov), 
                      data: { turbo_method: :patch, turbo_confirm: "Czy na pewno?" }, 
                      class: "ios-btn-back btn-sm" %>
                        <% end %>
                    </td>
                </tr>
                <% end %>
            </tbody>
        </table>
    </div>
    <% else %>
    <p class="text-muted mt-3">Brak przypisań pojazdów dla tego zamówienia.</p>
    <% end %>

    <%= link_to dispatcher_order_path(@order), class: "ios-back-btn ios-btn-back mt-3" do %>
    <i class="bi bi-arrow-left me-2"></i> Powrót
    <% end %>
</div>