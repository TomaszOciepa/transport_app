<div class="container my-4">
    <h3>Historia przypisań pojazdów dla zamówienia #<%= @order.order_number %></h3>

    <% if @order_vehicles.any? %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Pojazd</th>
                <th>Data zmiany</th>
                <th>Zmienione przez</th>
                <th>Aktualny</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            <% @order_vehicles.each do |ov| %>
            <tr>
                <td>
                    <%= link_to "#{ov.vehicle.brand} - #{ov.vehicle.registration_number}", dispatcher_vehicle_path(ov.vehicle), class: "text-decoration-underline" %>
                </td>
                <td><%= l(ov.updated_at, format: :long) %></td>
                <td><%= ov.user ? ov.user.email : "System" %></td>
                <td>
                    <% if ov.current %>
                    <span class="badge bg-success">Aktualny</span>
                    <% else %>
                    <span class="badge bg-secondary">Poprzedni</span>
                    <% end %>
                </td>
                <td>
                    <% if ov.current %>
                    <%= link_to "🗑️", unset_current_dispatcher_order_order_vehicle_path(@order, ov), 
                        data: { turbo_method: :patch, turbo_confirm: "Czy na pewno?" }, 
                        class: "btn btn-sm btn-outline-danger" %>



                    <% end %>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table>
    <% else %>
    <p class="text-muted">Brak przypisań pojazdów dla tego zamówienia.</p>
    <% end %>

    <%= link_to "Powrót", dispatcher_order_path(@order), class: "btn btn-secondary mt-3" %>
</div>