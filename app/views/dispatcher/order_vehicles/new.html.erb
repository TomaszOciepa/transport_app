<% title = "Przypisz pojazd do zamówienia" %>

<h3 class="mb-4"><%= title %> #<%= @order.order_number %></h3>

<%= form_with(model: [@order, @order_vehicle], 
              url: dispatcher_order_order_vehicles_path(@order), 
              local: true) do |f| %>

<%= render "form", 
        f: f, 
        selected_vehicle: @selected_vehicle, 
        vehicles: @vehicles %>

<div class="mt-3">
    <%= link_to dispatcher_order_path(@order), class: "ios-back-btn ios-btn-back me-2" do %>
    <i class="bi bi-arrow-left me-1"></i> Anuluj
    <% end %>

    <%= f.submit "Potwierdź przypisanie pojazdu", class: "ios-btn ios-btn-save" %>
</div>

<% end %>