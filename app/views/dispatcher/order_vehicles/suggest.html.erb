<div class="container my-5">
    <div class="text-center mb-5">
        <h3 class="fw-bold display-6 text-dark">
            <i class="bi bi-truck me-2 text-primary"></i>
            Sugerowane pojazdy
        </h3>
        <p class="text-muted fs-5 mt-2">
            dla zamówienia <strong class="text-dark">#<%= @order.order_number %></strong>
        </p>
    </div>

    <div class="text-center mb-4">
        <p class="mb-0 text-muted fst-italic">
            <i class="bi bi-geo-alt-fill me-2 text-success"></i>
            Punkt odbioru:
            <strong class="text-dark"><%= @order.pickup_address %></strong>
            <br>
          <i class="bi bi-clock me-2 text-warning"></i>
          Czas odbioru:
          <strong class="text-dark"><%= l(@order.pickup_date, format: :short) %></strong>
        </p>
    </div>

    <% if @vehicles_with_distance.any? %>
    <div class="row g-4 justify-content-center">
        <% @vehicles_with_distance.each do |data| %>
        <% vehicle = data[:vehicle] %>
        <% distance = data[:distance] %>
        <% eta = vehicle.eta_to_order(@order) %>


        <div class="col-md-6 col-lg-4">
            <div class="card ios-card shadow-sm rounded-4 p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-semibold text-dark mb-2">
                        <i class="bi bi-card-text me-1 text-primary"></i>
                        <%= link_to vehicle.registration_number, dispatcher_vehicle_path(vehicle), class: "text-decoration-none text-dark fw-bold" %>
                    </h5>
                    <p class="text-muted mb-3">
                        <i class="bi bi-car-front-fill me-2 text-primary"></i>
                        <%= vehicle.brand %>
                    </p>

                    
                    <% distance_color =
                                if distance.nil?
                                "text-secondary"
                                elsif distance <= 130
                                "text-success"      
                                elsif distance <= 200
                                "text-warning"      
                                else
                                "text-danger"  
                                end
                            %>

                    <p class="mb-1 fw-semibold <%= distance_color %>">
                        <i class="bi bi-geo-alt-fill me-2 <%= distance_color %>"></i>
                        <strong><%= distance %> km</strong> od punktu odbioru
                    </p>


                    <% if eta %>
                    <p class="mb-1 text-dark">
                        <i class="bi bi-clock me-2 text-warning"></i>
                        Szacowany przyjazd: <strong><%= l(eta, format: :short) %></strong>
                    </p>
                    <% end %>

                    <p class="mb-0 text-secondary small">
                        <i class="bi bi-speedometer2 me-2 text-info"></i>
                        Typ pojazdu: <%= vehicle.vehicle_type.name %>
                    </p>
                </div>

                <div class="mt-4">
                    <%= link_to "Wybierz pojazd",
                new_dispatcher_order_order_vehicle_path(@order, vehicle_id: vehicle.id),
                class: "btn btn-primary w-100 shadow-sm rounded-pill fw-semibold ios-btn" %>
                </div>
            </div>
        </div>
        <% end %>
    </div>
    <% else %>
    <div class="alert alert-warning rounded-4 shadow-sm d-flex align-items-center mt-4 p-4">
        <i class="bi bi-exclamation-triangle-fill fs-2 me-3 text-warning"></i>
        <div>
            <h6 class="fw-bold mb-1 text-dark">Brak dostępnych pojazdów</h6>
            <p class="mb-0 text-muted small">
                Żaden pojazd nie jest dostępny w wybranym okresie lub nie spełnia wymagań.
            </p>
        </div>
    </div>
    <% end %>

    <!-- Map -->
    <div class="card ios-map-card mt-5 mb-4 p-4 shadow-sm rounded-4">
        <h5 class="fw-semibold text-dark mb-3">
            <i class="bi bi-map me-2 text-primary"></i>Mapa pojazdów i punktu odbioru
        </h5>

        <div class="map-container" style="width: 100%; max-width: 900px; height: 400px; margin: 0 auto; border-radius: 16px; overflow: hidden;">
            <%= render(VehicleSuggestMapComponent.new(order: @order, vehicles: @vehicles)) %>
        </div>
    </div>

    <div class="text-center mt-4">
        <%= link_to dispatcher_order_path(@order),
      class: "btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold ios-back-btn" do %>
        <i class="bi bi-arrow-left me-2"></i>Powrót do zamówienia
        <% end %>
    </div>
</div>