<div class="container my-4">
  <h2 class="fw-bold mb-4">
    <%= @task_assignment.new_record? ? "Dodaj przypisanie do zadania" : "Edytuj przypisanie" %>
  </h2>

  <div class="card shadow-sm rounded-4 p-4">
    <%= form_with(model: [:dispatcher, @task.order, @task, @task_assignment], local: true) do |f| %>

      <% if @task_assignment.errors.any? %>
        <div class="alert alert-danger">
          <ul>
            <% @task_assignment.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row mb-3">
        <div class="col-md-6 mb-3">
          <%= f.label :driver_id, "Kierowca", class: "form-label" %>
          <%= f.collection_select :driver_id, Driver.all, :id, :full_name, { prompt: "Wybierz kierowcę" }, { class: "form-select" } %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :vehicle_id, "Pojazd", class: "form-label" %>
          <%= f.collection_select :vehicle_id, Vehicle.all, :id, :registration_number, { prompt: "Wybierz pojazd" }, { class: "form-select" } %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :status, "Status", class: "form-label" %>
          <%= f.select :status, TaskAssignment.statuses.keys.map { |s| [I18n.t("activerecord.attributes.task_assignment.statuses.#{s}"), s] }, {}, { class: "form-select" } %>
        </div>
      </div>

      <div class="mt-3">
        <%= f.submit @task_assignment.new_record? ? "Dodaj przypisanie" : "Zapisz zmiany", class: "btn btn-dark rounded-pill px-4 py-2 shadow-sm me-2" %>
        <%= link_to "Anuluj", dispatcher_order_task_path(@task.order, @task), class: "btn btn-outline-secondary rounded-pill px-4 py-2 shadow-sm" %>
      </div>

    <% end %>
  </div>
</div>
