<div class="container my-4">
    <h3><%= title %> #<%= @order.order_number %></h3>

    <% if @drivers.any? %>
    <%= form_with(model: [@order, @order_driver], url: dispatcher_order_order_drivers_path(@order), local: true) do |f| %>
    <div class="mb-3">
        <%= f.label :driver_id, "Wybierz kierowcę" %>
        <%= f.select :driver_id, @drivers.map { |d| [d.full_name, d.id] }, prompt: "Wybierz kierowcę", class: "form-select" %>
    </div>

    <%= f.submit "Zapisz", class: "btn btn-primary" %>
    <% end %>
    <% else %>
    <div class="static-warning mt-4 p-3 rounded-3">
        <div class="d-flex align-items-start">
            <div class="me-3">
                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Brak dostępnych kierowców</h6>
                <p class="mb-0 text-muted small">
                    Żaden kierowca nie jest obecnie dostępny w wybranym okresie.
                </p>
            </div>
        </div>
    </div>

    <%= link_to "Powrót do zamówienia", dispatcher_order_path(@order), class: "btn btn-secondary mt-3" %>
    <% end %>
</div>