<div id="chat_group_<%= group.id %>" class="chat-item d-flex justify-content-between align-items-center
         <%= 'active' if local_assigns[:active] %>" data-group-id="<%= group.id %>">

    <!-- LEFT -->
    <div class="d-flex align-items-center gap-2">
        <div class="chat-avatar">
            <%= group.driver&.first_name&.first || "?" %>
        </div>

        <div>
            <div class="fw-bold"><%= group.name %></div>
            <div class="text-muted" style="font-size: 0.8rem;">
                Kierowca:
                <%= group.driver&.first_name %>
                <%= group.driver&.last_name %>
            </div>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="d-flex align-items-center gap-1">
        <% unless group.order_sent %>
        <span class="badge bg-success" style="font-size:1rem; line-height:1;">!</span>
        <% end %>

        <small class="text-muted">
            <%= l(group.last_activity_at.to_date, format: :short) rescue "" %>
        </small>

        <% unread = group.unread_count %>
        <% if unread.positive? %>
        <span class="badge bg-success unread-badge">
            <%= unread %>
        </span>
        <% end %>
    </div>
</div>