<div class="bubble <%= msg.is_from_driver ? 'incoming' : 'outgoing' %>">

    <div class="bubble-sender">
        <% if msg.is_from_driver %>
        <%= msg.whatsapp_group.driver&.first_name %>
        <%= msg.whatsapp_group.driver&.last_name %>
        <% else %>
        Dyspozytor
        <% end %>
    </div>

    <div class="bubble-body">
        <% if msg.media.attached? %>

        <% if msg.image? %>
        <%= image_tag url_for(msg.media), class: "chat-image" %>

        <% elsif msg.video? %>
        <video controls class="chat-video">
            <source src="<%= url_for(msg.media) %>" type="<%= msg.media.content_type %>">
        </video>

        <% elsif msg.audio? %>
        <audio controls class="chat-audio">
            <source src="<%= url_for(msg.media) %>" type="<%= msg.media.content_type %>">
        </audio>

        <% else %>
        <a href="<%= url_for(msg.media) %>" target="_blank" class="chat-file">
            📎 <%= msg.media.filename.to_s %>
        </a>
        <% end %>

        <%# opcjonalny caption (WhatsApp-style) %>
        <% if msg.body.present? %>
        <p class="media-caption"><%= msg.body %></p>
        <% end %>

        <% else %>
        <%= simple_format(msg.body) %>
        <% end %>
    </div>

    <div class="bubble-time">
        <%= l(msg.timestamp, format: :short) %>
    </div>

</div>