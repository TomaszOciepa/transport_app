<div class="container-fluid mt-4" data-controller="chat">
  <div class="whatsapp-container">

    <!-- ================= LEFT COLUMN ================= -->
    <div class="whatsapp-sidebar">
      <div class="ws-header">
        <span>Wiadomości</span>
        <i class="bi bi-chat-dots fs-5"></i>
      </div>

      <!-- realtime lewa kolumna -->
      <%= turbo_stream_from "chat_notifications" %>

      <div class="chat-list" id="chatList">
        <% @groups.each do |group| %>
          <%= render "dispatcher/messages/chat_list_item",
                group: group,
                active: group == @active_group %>
        <% end %>
      </div>
    </div>

    <!-- ================= RIGHT COLUMN ================= -->
    <%= turbo_frame_tag "chat_panel", class: "whatsapp-chat-area" do %>

      <% if @active_group.present? %>

        <!-- HEADER -->
        <div class="chat-header d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-2">
            <div class="chat-avatar">
              <%= @active_group.driver&.first_name&.first || "?" %>
            </div>
            <div>
              <div class="fw-bold">
                <%= link_to dispatcher_order_path(@active_group.order),
                      class: "text-decoration-none text-dark",
                      title: "Przejdź do zamówienia",
                      data: { turbo_frame: "_top" } do %>
                  <%= @active_group.name %>
                <% end %>
              </div>

              <div class="text-muted" style="font-size: 0.8rem;">
                ID: <%= @active_group.id %> • Order: <%= @active_group.order_id %>
              </div>
            </div>
          </div>

          <%= button_to send_order_to_group_dispatcher_message_path(@active_group),
                method: :post,
                class: "chat-header-action text-button",
                title: "Wyślij zlecenie do tej grupy" do %>
            <i class="bi bi-clipboard-check"></i>
            <span class="action-label">Zlecenie</span>
          <% end %>
        </div>

        <!-- CHAT -->
        <div
          id="chatWrapper"
          data-chat-target="chatWrapper"
          style="position: relative; flex: 1; display: flex; flex-direction: column; min-height: 0;"
        >

          <div
            class="chat-messages"
            id="messagesBox"
            data-chat-target="messagesBox"
          >

            <!-- MUSI być id="messages" -->
            <%= turbo_frame_tag "messages", data: { chat_target: "messagesFrame" } do %>
              <% if @messages.any? %>
                <%= render partial: "dispatcher/messages/message",
                      collection: @messages,
                      as: :msg %>
              <% else %>
                <div class="text-center text-muted">
                  Brak wiadomości w tej grupie.
                </div>
              <% end %>
            <% end %>

            <!-- realtime prawa kolumna -->
            <%= turbo_stream_from "chat_channel_#{@active_group.id}" %>
          </div>

          <!-- indicator nowych wiadomości -->
          <div
            id="newMessageIndicator"
            data-chat-target="newMessageIndicator"
            data-action="click->chat#scrollToBottomFromIndicator"
            style="
                position: absolute;
                bottom: 10px;
                left: 50%;
                transform: translateX(-50%);
                background: #0d6efd;
                color: white;
                padding: 4px 12px;
                border-radius: 20px;
                cursor: pointer;
                display: none;
                z-index: 10;
            "
            >
            🔔 Nowe wiadomości ↓
            </div>

        </div>

        <!-- ❗ KOMUNIKAT BŁĘDU -->
        <div id="chat-errors"></div>

        <!-- INPUT -->
        <%= form_with url: send_whatsapp_dispatcher_messages_path,
              method: :post,
              local: false,
              html: { class: "chat-input-area", multipart: true } do |f| %>

          <!-- Upload file button -->
          <div class="chat-attach d-flex align-items-center gap-2" data-controller="file-indicator">

            <!-- PRZYCISK PLUS -->
            <label
              for="media-input"
              class="attach-btn"
              title="Dodaj plik"
              data-chat-target="attachButton"
              data-file-indicator-target="button"
            >
              <i class="bi bi-plus-lg"></i>
            </label>

            <!-- INPUT FILE (UKRYTY) -->
            <%= f.file_field :media,
                  id: "media-input",
                  accept: "image/*,video/*,application/pdf",
                  class: "d-none",
                  data: {
                    chat_target: "mediaInput",
                    action: "change->file-indicator#fileSelected"
                  } %>

            <!-- PODGLĄD NAZWY PLIKU -->
            <div
              class="file-preview text-muted small d-none"
              data-chat-target="filePreview"
              data-file-indicator-target="preview"
            ></div>
          </div>

          <%= f.text_area :body,
                id: "whatsappMessageBody",
                class: "form-control",
                rows: 1,
                placeholder: "Napisz wiadomość…",
                autocomplete: "off",
                data: { chat_target: "textarea" } %>

          <%= f.hidden_field :whatsapp_group_id, value: @active_group.id %>

          <button type="submit" class="btn btn-success">
            <i class="bi bi-send-fill"></i>
          </button>
        <% end %>

      <% else %>

        <div class="h-100 d-flex justify-content-center align-items-center text-muted">
          <div class="text-center">
            <i class="bi bi-chat fs-1 text-muted"></i>
            <p>Wybierz rozmowę z listy.</p>
          </div>
        </div>

      <% end %>

    <% end %>
  </div>
</div>
