<div class="container-fluid mt-4">
    <div class="whatsapp-container">

        <!-- ================= LEFT COLUMN ================= -->
        <div class="whatsapp-sidebar">
            <div class="ws-header">
                <span>Wiadomości</span>
                <i class="bi bi-chat-dots fs-5"></i>
            </div>

            <!-- realtime lewa kolumna -->
            <%= turbo_stream_from "chat_notifications" %>

            <div class="chat-list" id="chatList">
                <% @groups.each do |group| %>
                <%= link_to dispatcher_messages_path(group_id: group.id),
              class: "text-decoration-none text-dark chat-link",
              data: { turbo_frame: "chat_panel", group_id: group.id } do %>

                <%= render "dispatcher/messages/chat_row",
              group: group,
              active: group == @active_group %>

                <% end %>
                <% end %>
            </div>
        </div>

        <!-- ================= RIGHT COLUMN ================= -->
        <%= turbo_frame_tag "chat_panel", class: "whatsapp-chat-area" do %>

        <% if @active_group.present? %>

        <!-- HEADER -->
        <div class="chat-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="chat-avatar">
                    <%= @active_group.driver&.first_name&.first || "?" %>
                </div>
                <div>
                    <div class="fw-bold">
                        <%= link_to @active_group.name,
                  dispatcher_order_path(@active_group.order),
                  class: "text-decoration-none text-dark" %>
                    </div>
                    <div class="text-muted" style="font-size: 0.8rem;">
                        ID: <%= @active_group.id %> • Order: <%= @active_group.order_id %>
                    </div>
                </div>
            </div>

            <%= button_to "Wyślij zlecenie",
              send_order_to_group_dispatcher_message_path(@active_group),
              method: :post,
              class: "btn btn-warning btn-sm" %>
        </div>

        <!-- CHAT -->
        <div id="chatWrapper" style="position: relative; flex: 1; display: flex; flex-direction: column; min-height: 0;">

            <div class="chat-messages" id="messagesBox">

                <!-- MUSI być id="messages" -->
                <%= turbo_frame_tag "messages" do %>
                <% if @messages.any? %>
                <%= render partial: "dispatcher/messages/message",
                    collection: @messages,
                    as: :msg %>
                <% else %>
                <div class="text-center text-muted">
                    Brak wiadomości w tej grupie.
                </div>
                <% end %>
                <% end %>

                <!-- realtime prawa kolumna -->
                <%= turbo_stream_from "chat_channel_#{@active_group.id}" %>
            </div>

            <!-- indicator nowych wiadomości -->
            <div id="newMessageIndicator" style="
              position: absolute;
              bottom: 10px;
              left: 50%;
              transform: translateX(-50%);
              background: #0d6efd;
              color: white;
              padding: 4px 12px;
              border-radius: 20px;
              cursor: pointer;
              display: none;
              z-index: 10;
            ">
                Nowe wiadomości
            </div>
        </div>

        <!-- INPUT -->
        <%= form_with url: send_whatsapp_dispatcher_messages_path,
          method: :post,
          local: false,
          html: { class: "chat-input-area" } do |f| %>

        <%= f.text_area :body,
            id: "whatsappMessageBody",
            class: "form-control",
            rows: 1,
            placeholder: "Napisz wiadomość…",
            autocomplete: "off" %>

        <%= f.hidden_field :whatsapp_group_id, value: @active_group.id %>

        <button type="submit" class="btn btn-success">
            <i class="bi bi-send-fill"></i>
        </button>
        <% end %>

        <% else %>

        <div class="h-100 d-flex justify-content-center align-items-center text-muted">
            <div class="text-center">
                <i class="bi bi-chat fs-1 text-muted"></i>
                <p>Wybierz rozmowę z listy.</p>
            </div>
        </div>

        <% end %>

        <% end %>
    </div>
</div>

<!-- ================= JS ================= -->
<script>
    (function() {

        /* ================= MARK AS READ (DEBUG) ================= */

        function markChatAsRead(groupId) {
            console.log("📤 markChatAsRead() called for group:", groupId);

            fetch(`/dispatcher/messages/${groupId}/mark_as_read`, {
                    method: "POST",
                    headers: {
                        "X-CSRF-Token": document
                            .querySelector("meta[name='csrf-token']")
                            .content
                    }
                })
                .then(response => {
                    console.log("📥 mark_as_read response status:", response.status);
                })
                .catch(error => {
                    console.error("❌ mark_as_read error:", error);
                });
        }

        /* ================= ACTIVE CHAT ================= */

        function markActiveFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const groupId = params.get("group_id");
            if (!groupId) return;

            document.querySelectorAll(".chat-item.active")
                .forEach(el => el.classList.remove("active"));

            const item = document.querySelector(
                `.chat-item[data-group-id='${groupId}']`
            );
            if (item) item.classList.add("active");
        }

        document.addEventListener("click", function(e) {
            const link = e.target.closest(".chat-link");
            if (!link) return;

            const groupId = link.dataset.groupId;
            if (!groupId) return;

            console.log("🖱️ chat clicked, groupId =", groupId);

            document.querySelectorAll(".chat-item.active")
                .forEach(el => el.classList.remove("active"));

            const item = document.querySelector(
                `.chat-item[data-group-id='${groupId}']`
            );
            if (item) item.classList.add("active");

            // 🔥 TUTAJ oznaczamy jako przeczytane
            markChatAsRead(groupId);
        });

        /* ================= CHAT LOGIC ================= */

        function initChat() {
            const textarea = document.getElementById("whatsappMessageBody");
            const messagesBox = document.getElementById("messagesBox");
            const messagesFrame = document.getElementById("messages");
            const indicator = document.getElementById("newMessageIndicator");

            if (!textarea || !messagesBox || !messagesFrame) return;

            /* ENTER / SHIFT+ENTER */
            if (!textarea.dataset.enterBound) {
                textarea.dataset.enterBound = "1";
                textarea.addEventListener("keydown", function(e) {
                    if (e.key === "Enter" && !e.shiftKey) {
                        e.preventDefault();
                        textarea.form.requestSubmit();
                    }
                });
            }

            /* CLEAR AFTER SEND */
            if (!window.__chatSubmitBound) {
                window.__chatSubmitBound = true;
                document.addEventListener("turbo:submit-end", function(e) {
                    const form = e.target;
                    if (!form.classList.contains("chat-input-area")) return;
                    textarea.value = "";
                    textarea.focus();
                });
            }

            /* SCROLL */
            const BOTTOM_THRESHOLD = 150;
            let userNearBottom = true;
            let newCount = 0;

            const scrollToBottom = (smooth = false) => {
                messagesBox.scrollTo({
                    top: messagesBox.scrollHeight,
                    behavior: smooth ? "smooth" : "auto"
                });
            };

            const updatePosition = () => {
                userNearBottom =
                    messagesBox.scrollTop + messagesBox.clientHeight >=
                    messagesBox.scrollHeight - BOTTOM_THRESHOLD;

                if (userNearBottom && indicator) {
                    newCount = 0;
                    indicator.style.display = "none";
                }
            };

            if (!messagesBox.dataset.scrollBound) {
                messagesBox.dataset.scrollBound = "1";
                messagesBox.addEventListener("scroll", updatePosition);
            }

            /* OBSERVER – NA turbo-frame#messages */
            if (window.__chatObserver) {
                try {
                    window.__chatObserver.disconnect();
                } catch (e) {}
            }

            window.__chatObserver = new MutationObserver(() => {
                if (userNearBottom) {
                    scrollToBottom(true);
                } else if (indicator) {
                    newCount++;
                    indicator.innerText = `Nowe wiadomości (${newCount})`;
                    indicator.style.display = "block";
                }
            });

            window.__chatObserver.observe(messagesFrame, {
                childList: true,
                subtree: true
            });

            if (indicator && !indicator.dataset.bound) {
                indicator.dataset.bound = "1";
                indicator.addEventListener("click", () => {
                    scrollToBottom(true);
                    newCount = 0;
                    indicator.style.display = "none";
                });
            }

            setTimeout(() => scrollToBottom(false), 100);
        }

        document.addEventListener("turbo:load", () => {
            markActiveFromUrl();
            initChat();
        });

        document.addEventListener("turbo:frame-load", e => {
            if (e.target.id === "chat_panel") {
                markActiveFromUrl();
                initChat();
            }
        });

    })();
</script>