<div class="container-fluid mt-4">
    <div class="whatsapp-container">

        <!-- LEFT COLUMN -->
        <div class="whatsapp-sidebar">
            <div class="ws-header">
                <span>Wiadomości</span>
                <i class="bi bi-chat-dots fs-5"></i>
            </div>

            <div class="chat-list">
                <% @groups.each do |g| %>
                <% is_active = (g == @active_group) %>
                <%= link_to dispatcher_messages_path(group_id: g.id), class: "text-decoration-none text-dark" do %>
                <div class="chat-item <%= 'active' if is_active %> d-flex justify-content-between align-items-center" data-group-id="<%= g.id %>">
                    <div class="d-flex align-items-center gap-2">
                        <div class="chat-avatar"><%= g&.driver&.first_name&.first || "?" %></div>
                        <div>
                            <div class="fw-bold"><%= g.name %></div>
                            <div class="text-muted" style="font-size: 0.8rem;">
                                Kierowca: <%= g.driver&.first_name %> <%= g.driver&.last_name %><br>
                                <%= truncate(g.whatsapp_group_id.to_s, length: 40) %>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <% unless g.order_sent %>
                        <span class="badge bg-danger" style="font-size:1rem; line-height:1;">!</span>
                        <% end %>
                        <small class="text-muted"><%= g.created_at.strftime("%d.%m") %></small>
                    </div>
                </div>
                <% end %>
                <% end %>
            </div>
        </div>

        <!-- RIGHT COLUMN (CHAT) -->
        <div class="whatsapp-chat-area">
            <% if @active_group.present? %>
            <div class="chat-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="chat-avatar"><%= @active_group&.driver&.first_name&.first || "?" %></div>
                    <div>
                        <div class="fw-bold">
                            <%= link_to @active_group.name, dispatcher_order_path(@active_group.order), class: "text-decoration-none text-dark" %>
                        </div>
                        <div class="text-muted" style="font-size: 0.8rem;">
                            ID: <%= @active_group.id %> • Order: <%= @active_group.order_id %>
                        </div>
                    </div>
                </div>

                <div class="ms-auto">
                    <%= button_to "Wyślij zlecenie", send_order_to_group_dispatcher_message_path(@active_group), method: :post, class: "btn btn-warning btn-sm" %>
                </div>
            </div>

            <!-- CHAT WRAPPER -->
            <div id="chatWrapper" style="position: relative; flex: 1; display: flex; flex-direction: column;">
                <div class="chat-messages" id="messagesBox">
                    <%= turbo_frame_tag "messages" do %>
                    <% if @messages.any? %>
                    <%= render partial: "dispatcher/messages/message", collection: @messages, as: :msg %>
                    <% else %>
                    <div class="text-center text-muted">Brak wiadomości w tej grupie.</div>
                    <% end %>
                    <% end %>

                    <%= turbo_stream_from "chat_channel_#{@active_group.id}" %>
                </div>

                <!-- New message indicator -->
                <div id="newMessageIndicator" style="
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            background: #0d6efd;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            cursor: pointer;
            display: none;
            z-index: 10;
          ">Nowa wiadomość</div>
            </div>

            <!-- input area -->
            <%= form_with url: send_whatsapp_dispatcher_messages_path, method: :post, local: true, html: { class: "chat-input-area" } do |f| %>
            <%= f.text_area :body, class: "form-control", rows: 1, placeholder: "Napisz wiadomość..." %>
            <%= f.hidden_field :whatsapp_group_id, value: @active_group.id %>
            <button class="btn btn-success"><i class="bi bi-send-fill"></i></button>
            <% end %>

            <% else %>
            <div class="h-100 d-flex justify-content-center align-items-center text-muted">
                <div class="text-center">
                    <i class="bi bi-chat fs-1 text-muted"></i>
                    <p>Wybierz rozmowę z listy.</p>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>

<script>
    (function() {
        const box = document.getElementById("messagesBox");
        const newMessageIndicator = document.getElementById("newMessageIndicator");
        const BOTTOM_THRESHOLD = 150;
        let userNearBottom = true;
        let newMessageCount = 0;

        if (!box) return;

        function scrollToBottom(smooth = false) {
            if (smooth) {
                box.scrollTo({
                    top: box.scrollHeight,
                    behavior: "smooth"
                });
            } else {
                box.scrollTop = box.scrollHeight;
            }
        }

        function updateUserPosition() {
            userNearBottom = (box.scrollTop + box.clientHeight >= box.scrollHeight - BOTTOM_THRESHOLD);
            if (userNearBottom) {
                newMessageCount = 0;
                newMessageIndicator.style.display = 'none';
            }
        }

        // Initial scroll
        function initialScroll() {
            setTimeout(() => {
                scrollToBottom(false);
                updateUserPosition();
            }, 50);
        }

        document.addEventListener("DOMContentLoaded", initialScroll);
        document.addEventListener("turbo:frame-load", initialScroll);
        box.addEventListener("scroll", updateUserPosition);

        // Observe new messages
        const observer = new MutationObserver((mutations) => {
            mutations.forEach(mutation => {
                mutation.addedNodes.forEach(node => {
                    if (node.nodeType === 1 && node.querySelector('.bubble')) {
                        if (userNearBottom) {
                            scrollToBottom(true);
                        } else {
                            newMessageCount += 1;
                            newMessageIndicator.innerText = `Nowe wiadomości (${newMessageCount})`;
                            newMessageIndicator.style.display = 'block';
                        }
                    }
                });
            });
        });

        observer.observe(box, {
            childList: true,
            subtree: false
        });

        newMessageIndicator.addEventListener('click', () => {
            scrollToBottom(true);
            newMessageCount = 0;
            newMessageIndicator.style.display = 'none';
        });

        window.addEventListener("beforeunload", () => observer.disconnect());
    })();
</script>