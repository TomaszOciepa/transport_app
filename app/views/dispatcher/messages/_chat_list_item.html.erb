<%= link_to dispatcher_messages_path(group_id: group.id, t: Time.current.to_i),
  class: "text-decoration-none text-dark chat-link",
  data: {
    turbo_frame: "chat_panel",
    turbo_action: "advance",
    group_id: group.id
  } do %>


  <%= render "dispatcher/messages/chat_row",
          group: group,
          active: local_assigns[:active] %>

<% end %>
