<div class="container my-4">
    <h3 class="mb-4"> <%= title %> — <%= @vehicle.brand %> </h3>

    <% if @drivers.any? %>
    <div class="pastel-box p-4">
        <%= form_with(model: [@vehicle, @vehicle_driver], url: dispatcher_vehicle_vehicle_drivers_path(@vehicle), local: true) do |f| %>

        <div class="mb-4">
            <%= f.label :driver_id, "Wybierz kierowcę", class: "form-label fw-semibold" %>
            <%= f.select :driver_id,
              @drivers.map { |d| ["#{d.full_name} (#{d.license_category.name})", d.id] },
              { prompt: "Wybierz kierowcę" },
              class: "form-select ios-select" %>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <%= link_to dispatcher_vehicle_path(@vehicle), class: "ios-back-btn ios-btn-back" do %>
            <i class="bi bi-arrow-left me-2"></i> Powrót do pojazdu
            <% end %>

            <%= f.submit "Przypisz kierowcę", class: "ios-btn ios-btn-save mb-0" %>
        </div>

        <% end %>
    </div>
    <% else %>
    <div class="static-warning mt-4 p-3 rounded-3">
        <div class="d-flex align-items-start">
            <div class="me-3">
                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Brak dostępnych kierowców</h6>
                <p class="mb-0 text-muted small">
                    Żaden kierowca nie jest obecnie dostępny lub jest już przypisany do innego pojazdu.
                </p>
            </div>
        </div>

        <%= link_to dispatcher_vehicle_path(@vehicle), class: "ios-back-btn ios-btn-back mt-3" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót do pojazdu
        <% end %>
    </div>
    <% end %>
</div>