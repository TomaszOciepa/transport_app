<div class="container my-4">
  <h2 class="fw-bold mb-4"><%= @task.new_record? ? "Dodaj nowy task" : "Edytuj task" %></h2>

  <div class="card shadow-sm rounded-4 p-4">
    <%= form_with model: [:dispatcher, @order, @task], local: true do |f| %>
      
      <% if @task.errors.any? %>
        <div class="alert alert-danger">
          <ul>
            <% @task.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row mb-3">
        <div class="col-md-6 mb-3">
          <%= f.label :name, "Nazwa taska", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :status, "Status", class: "form-label" %>
          <%= f.select :status, Task.statuses.keys.map { |s| [I18n.t("activerecord.attributes.task.statuses.#{s}"), s] }, {}, class: "form-select" %>
        </div>

          <div class="col-md-6 mb-3">
            <%= f.label :planned_start_time, "Planowany start", class: "form-label" %>
            <%= f.datetime_local_field :planned_start_time, value: @task.planned_start_time&.strftime("%Y-%m-%dT%H:%M"), class: "form-control" %>
          </div>

          <div class="col-md-6 mb-3">
            <%= f.label :planned_end_time, "Planowany koniec", class: "form-label" %>
            <%= f.datetime_local_field :planned_end_time, value: @task.planned_end_time&.strftime("%Y-%m-%dT%H:%M"), class: "form-control" %>
          </div>


      <div class="mt-3">
        <%= f.submit @task.new_record? ? "Dodaj task" : "Zapisz zmiany", 
                     class: "btn btn-dark rounded-pill px-4 py-2 shadow-sm me-2" %>
        <%= link_to "Anuluj", dispatcher_order_path(@order), 
                    class: "btn btn-outline-secondary rounded-pill px-4 py-2 shadow-sm ms-2" %>
      </div>

    <% end %>
  </div>
</div>
