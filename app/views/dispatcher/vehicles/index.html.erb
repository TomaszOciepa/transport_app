<div class="container-fluid py-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-2" style="color: #2c2c2c;"><%= @page_title %></h2>
        <%= render "vehicles_menu" %>
    </div>

    <div class="row g-4">
        <!-- Left Column: Suggestions -->
        <div class="col-lg-6">
            <h4 class="fw-bold mb-3 d-flex justify-content-between align-items-center" style="color: #2c2c2c;">
                🧭 Centrum sugestii
                <% if @vehicle_availability_alerts.any? %>
                <span class="badge bg-secondary rounded-pill">
                    <%= @vehicle_availability_alerts.size %> pojazdy
                </span>
                <% end %>
            </h4>

            <div class="suggestions-container d-flex flex-column gap-3">

                <% if @vehicle_availability_alerts.any? %>
                <% @vehicle_availability_alerts.each do |alert| %>
                <% vehicle = alert[:vehicle] %>
                <% days_left = alert[:days_left] %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: <%= days_left < 4 ? '#FFE5E5' : '#FFF6E5' %>;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi <%= days_left < 4 ? 'bi-exclamation-octagon-fill text-danger' : 'bi-exclamation-triangle-fill text-warning' %> fs-3"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">
                                <%= vehicle.brand %> – <%= vehicle.registration_number %>
                            </h6>
                            <p class="text-muted small mb-0">
                                Dostępność kończy się za <strong><%= days_left %></strong> dni.
                            </p>
                            <%= link_to "Zarządzaj dostępnością", dispatcher_vehicle_path(vehicle),
                  class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1" %>
                        </div>
                    </div>
                </div>
                <% end %>
                <% else %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #E9FBEF;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Wszystko w porządku!</h6>
                            <p class="text-muted small mb-0">
                                Wszystkie pojazdy mają wystarczającą dostępność na najbliższe dni.
                            </p>
                        </div>
                    </div>
                </div>
                <% end %>

                <!-- 🚨 No driver assigned -->
                <% if @vehicles_without_driver.any? %>
                <% @vehicles_without_driver.each do |vehicle| %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #FFF6E5;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-person-dash-fill text-warning fs-3"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">
                                <%= vehicle.brand %> – <%= vehicle.registration_number %>
                            </h6>
                            <p class="text-muted small mb-0">
                                Ten pojazd <strong>nie ma przypisanego kierowcy</strong>.
                            </p>
                            <%= link_to "Przypisz kierowcę", dispatcher_vehicle_path(vehicle),
              class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1" %>
                        </div>
                    </div>
                </div>
                <% end %>
                <% else %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #E9FBEF;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Wszystko w porządku!</h6>
                            <p class="text-muted small mb-0">
                                Wszystkie pojazdy mają przypisanych kierowców 🚛✨
                            </p>
                        </div>
                    </div>
                </div>
                <% end %>


                <% if @unavailable_vehicles > 0 %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #FFE5E5;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-x-circle fs-3 text-danger"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Niedostępne pojazdy</h6>
                            <p class="text-muted small mb-2">
                                Masz <strong><%= @unavailable_vehicles %></strong> pojazdów niedostępnych w tym momencie.
                            </p>
                            <%= link_to "Przeglądaj dostępność", unavailable_vehicles_dispatcher_vehicles_path,
                class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold" %>
                        </div>
                    </div>
                </div>
                <% else %>
                <div class="card shadow-sm rounded-4 border-0 p-4" style="background-color: #E9FBEF;">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #2c2c2c;">Świetna robota!</h6>
                            <p class="text-muted small mb-0">
                                Wszystkie pojazdy są dostępne. Możesz spokojnie planować dyspozycje 💪
                            </p>
                        </div>
                    </div>
                </div>
                <% end %>

            </div>
        </div>



        <!-- Right Column: Statistics -->
        <div class="col-lg-6">
            <h4 class="fw-bold mb-3" style="color: #2c2c2c;">📊 Statystyki pojazdów</h4>

            <div class="row g-3">
                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #9AD0EC;">
                        <i class="bi bi-truck fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">Wszystkie</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @total_vehicles %></p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #B5EAD7;">
                        <i class="bi bi-check-circle-fill fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">Dostępne</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @available_vehicles %></p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #FFD6A5;">
                        <i class="bi bi-truck fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">W użyciu</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @busy_vehicles %></p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card shadow-sm rounded-4 text-center border-0 p-3 stat-card" style="background-color: #FFB7B2;">
                        <i class="bi bi-x-circle-fill fs-2 text-white mb-2"></i>
                        <h6 class="fw-semibold text-white mb-1">Nieaktywne</h6>
                        <p class="fs-5 fw-bold text-white mb-0"><%= @inactive_vehicles %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>