<div class="container-fluid py-5">
    <div class="d-flex flex-column mb-4">
        <h2 class="fw-bold mb-2"><%= @page_title %></h2>
        <%= render "vehicles_menu" %>
    </div>

    <div class="row g-4">
        <!-- Left Column: Suggestions -->
        <div class="col-lg-6">
            <h4 class="suggestions-header fw-bold mb-3 d-flex justify-content-between align-items-center px-1">
            <span class="d-flex align-items-center gap-2">
            <span class="suggestions-header__icon">🧭</span>
            <span class="suggestions-header__title">
                Zadania do wykonania <span class="suggestions-header__accent">"TO DO LIST"</span>
            </span>
            </span>
    
            <% total_vehicle_tasks = @vehicles_needing_attention.size %>
            <% if total_vehicle_tasks > 0 %>
            <span class="badge suggestions-badge rounded-pill px-3 py-2 shadow-sm">
                <%= total_vehicle_tasks %> zadań
            </span>
            <% end %>
        </h4>


        <div class="suggestions-container d-flex flex-column gap-3">
        <% if @vehicles_needing_attention.any? %>
      
          <% @vehicles_needing_attention.each do |alert| %>
            <% vehicle = alert[:vehicle] %>
            <% driver  = alert[:driver] %>
      
            <% card_class =
              case alert[:type]
              when :no_driver
                "bg-warning-soft"
              when :expiring_vehicle_availability, :expiring_driver_availability
                alert[:days_left] < 4 ? "bg-danger-soft" : "bg-warning-light"
              else
                "bg-white"
              end
            %>
      
            <% icon_class =
              case alert[:type]
              when :no_driver
                "bi-person-x-fill text-warning"
              when :expiring_vehicle_availability
                "bi-exclamation-triangle-fill text-danger"
              when :expiring_driver_availability
                "bi-person-exclamation text-warning"
              else
                "bi-info-circle text-secondary"
              end
            %>
      
            <div class="card suggestion-card shadow-sm rounded-4 border-0 p-4 <%= card_class %>">
              <div class="d-flex align-items-start gap-3">
                <i class="bi <%= icon_class %> fs-3"></i>
      
                <div>
                  <h6 class="fw-bold mb-1 suggestion-title">
                    <%= link_to dispatcher_vehicle_path(vehicle), class: "suggestion-link" do %>
                      <%= vehicle.brand %> – <%= vehicle.registration_number %>
                    <% end %>
                  </h6>
      
                  <% case alert[:type] %>
                  <% when :no_driver %>
                    <p class="suggestion-text">
                      Ten pojazd <strong>nie ma przypisanego kierowcy</strong>.
                    </p>
                    <%= link_to "Przypisz kierowcę",
                      dispatcher_vehicle_path(vehicle),
                      class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1" %>
      
                  <% when :expiring_vehicle_availability %>
                    <p class="suggestion-text">
                      Dostępność pojazdu kończy się za <strong><%= alert[:days_left] %></strong> dni.
                    </p>
                    <%= link_to "Zarządzaj dostępnością pojazdu",
                      dispatcher_vehicle_path(vehicle),
                      class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1" %>
      
                  <% when :expiring_driver_availability %>
                    <p class="suggestion-text">
                      Kierowca <strong><%= driver.full_name %></strong> ma dostępność tylko przez
                      <strong><%= alert[:days_left] %></strong> dni.
                    </p>
                    <%= link_to "Zarządzaj kierowcą",
                      dispatcher_driver_path(driver),
                      class: "btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold mt-1" %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
      
        <% else %>
        
            <div class="card suggestion-card shadow-sm rounded-4 border-0 p-4 bg-success-soft">
            <div class="d-flex align-items-start gap-3">
            <i class="bi bi-check-circle-fill fs-3 text-success"></i>
            <div>
                <h6 class="fw-bold mb-1 suggestion-title">Wszystko w porządku!</h6>
                <p class="suggestion-text">
                Wszystkie pojazdy mają przypisanych kierowców i aktualną dostępność 🚗✨
                </p>
            </div>
            </div>
        </div>
      
        <% end %>
            </div>


        </div>



        <!-- Right Column: Statistics -->
        <div class="col-lg-6">
        <h4 class="fw-bold mb-3 page-subtitle">📊 Statystyki pojazdów</h4>
      
        <div class="row g-3">
          <div class="col-6">
            <div class="card stat-card bg-blue text-center border-0 p-3">
              <i class="bi bi-truck fs-2 text-white mb-2"></i>
              <h6 class="fw-semibold text-white mb-1">Wszystkie</h6>
              <p class="fs-5 fw-bold text-white mb-0"><%= @total_vehicles %></p>
            </div>
          </div>
      
          <div class="col-6">
            <div class="card stat-card bg-green text-center border-0 p-3">
              <i class="bi bi-check-circle-fill fs-2 text-white mb-2"></i>
              <h6 class="fw-semibold text-white mb-1">Dostępne</h6>
              <p class="fs-5 fw-bold text-white mb-0"><%= @available_vehicles %></p>
            </div>
          </div>
      
          <div class="col-6">
            <div class="card stat-card bg-yellow text-center border-0 p-3">
              <i class="bi bi-truck fs-2 text-white mb-2"></i>
              <h6 class="fw-semibold text-white mb-1">W użyciu</h6>
              <p class="fs-5 fw-bold text-white mb-0"><%= @busy_vehicles %></p>
            </div>
          </div>
      
          <div class="col-6">
            <div class="card stat-card bg-pink text-center border-0 p-3">
              <i class="bi bi-x-circle-fill fs-2 text-white mb-2"></i>
              <h6 class="fw-semibold text-white mb-1">Nieaktywne</h6>
              <p class="fs-5 fw-bold text-white mb-0"><%= @inactive_vehicles %></p>
            </div>
          </div>
        </div>
      </div>
      
    </div>
</div>