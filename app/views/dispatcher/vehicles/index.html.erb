<div class="container-fluid py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Lista pojazdów</h2>
        <%= link_to "Dodaj nowy pojazd", new_dispatcher_vehicle_path, class: "ios-btn shadow-sm rounded-pill px-4 py-2" %>
    </div>

    <div class="table-responsive shadow-sm rounded-4 pastel-box p-3">
        <table class="table table-hover mb-0 align-middle">
            <thead class="pastel-thead">
                <tr>
                    <th class="text-center">Lp</th>
                    <th><%= sortable "brand", "Marka" %></th>
                    <th><%= sortable "registration_number", "Numer rejestracyjny" %></th>
                    <th><%= sortable "vehicle_type_id", "Typ pojazdu" %></th>
                    <th><%= sortable "status", "Status" %></th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                <%@vehicles.each_with_index do |vehicle, index| %>
                <tr>
                    <td class="text-center text-muted"><%= index + 1 %></td>
                    <td><%= vehicle.brand %></td>
                    <td><%= vehicle.registration_number %></td>
                    <td><%= vehicle.vehicle_type&.name %></td>
                    <td>
                        <% status_class = case vehicle.current_status
                when "available" then "status-badge completed"
                when "in_transit" then "status-badge in_progress"
                when "unavailable" then "status-badge canceled"
                else "status-badge pending"
              end %>
                        <span class="<%= status_class %> rounded-pill px-3 py-1 fw-semibold">
                            <%= vehicle.current_status_i18n %>
                        </span>
                    </td>
                    <td>
                        <%= link_to dispatcher_vehicle_path(vehicle), class: "ios-btn btn-sm shadow-sm d-flex align-items-center justify-content-center" do %>
                        <i class="bi bi-gear me-1"></i> Szczegóły
                        <% end %>
                    </td>
                </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>