<div class="container my-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">
            <!-- Actions -->
            <div class="mb-4 d-flex gap-2">
                <%= link_to edit_dispatcher_vehicle_path(@vehicle), class: "ios-fab-btn", title: "Edytuj" do %>
                <i class="bi bi-pencil"></i> Edytuj
                <% end %>

                <%= link_to dispatcher_vehicle_path(@vehicle),
                data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć ten pojazd?" },
                class: "ios-fab-btn", title: "Usuń" do %>
                <i class="bi bi-trash"></i> Usuń
                <% end %>
            </div>
        </h2>
        <small class="text-muted">Utworzono: <%= l(@vehicle.created_at, format: :long) %></small>
    </div>

    
    <!-- Dane pojazdu -->
    <div class="card shadow-sm rounded-4 p-4 mb-4 driver-profile-card">

                <!-- HEADER PROFILU -->
                <div class="d-flex align-items-center mb-4">

                    <div class="driver-avatar me-4">
                        <%= image_tag vehicle_logo_for(@vehicle), class: "driver-avatar-img" %>
                    </div>


                    <div class="flex-grow-1">
                    <h4 class="mb-1 fw-bold">
                       Pojazd
                    </h4>

                    <div class="text-muted small">
                        <%= @vehicle.registration_number %>
                    </div>
                    </div>

                    <div class="text-end small">
                    <div><strong>Status:</strong>
                        <% status_class = case @vehicle.current_status
                        when "available" then "bg-success"
                        when "busy" then "bg-primary"
                        when "unavailable" then "bg-danger"
                        else "bg-secondary"
                        end %>
                        <span class="badge <%= status_class %> rounded-pill px-3 py-1">
                        <%= @vehicle.current_status_i18n %>
                        </span>
                    </div>
                    </div>

                </div>

                <div class="row">

                    <!-- LEWA KOLUMNA -->
                    <div class="col-md-6 border-end pe-4">

                    <h6 class="text-muted mb-3">Dane pojazdu</h6>

                    <div class="driver-info-row">
                        <span>Marka</span>
                        <strong><%= @vehicle.brand %></strong>
                    </div>
                    
                    <div class="driver-info-row">
                        <span>Typ pojazdu</span>
                        <strong><%= @vehicle.vehicle_type&.name %></strong>
                    </div>

                    <div class="driver-info-row">
                        <span>Rok produkcji</span>
                        <strong>2021</strong>
                    </div>

                    <div class="driver-info-row">
                        <span>Numer rejestracyjny</span>
                        <strong><%= @vehicle.registration_number %></strong>
                    </div>

                </div>

            <!-- PRAWA KOLUMNA -->
            <div class="col-md-6 ps-4">

            <h6 class="text-muted mb-3">Pozostałe informacje</h6>

            <div class="driver-info-row">
                    <span>Przebieg</span>
                    <strong>400343 km</strong>
                </div>
                
                <div class="driver-info-row">
                    <span>Termin badania technicznego</span>
                    <strong>19.06.2025</strong>
                </div>

                <div class="driver-info-row">
                    <span>Następne badanie techniczne</span>
                    <strong>19.06.2026</strong>
                </div>

            <div class="driver-info-row">
                <span>Następny serwis</span>
                <strong>18.06.2026</strong>
            </div>


            </div>

        </div>

    </div>

        <!-- Przypisany kierowca -->
        <div class="card shadow-sm rounded-4 p-4 mb-4 driver-section-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="section-title">
            <i class="bi bi-person-badge me-2"></i>Przypisany kierowca
            </h6>

            <div class="d-flex gap-2">
            <%= link_to new_dispatcher_vehicle_vehicle_driver_path(@vehicle),
                class: "btn btn-sm btn-light border" do %>
                <i class="bi bi-plus-lg me-1"></i>
                Przypisz / Zmień
            <% end %>

            <%= link_to dispatcher_vehicle_vehicle_drivers_path(@vehicle),
                class: "btn btn-sm btn-light border" do %>
                <i class="bi bi-clock-history me-1"></i> Historia
            <% end %>
            </div>
        </div>

        <% current_assignment = @vehicle.vehicle_drivers.find_by(current: true) %>
        <% driver = current_assignment&.driver %>

        <% if driver.present? %>
            <div class="driver-info-row">
            <span>Kierowca</span>
            <strong>
                <%= link_to driver.full_name,
                    dispatcher_driver_path(driver),
                    class: "text-decoration-underline" %>
            </strong>
            </div>

            <div class="driver-info-row">
            <span>Status kierowcy</span>
            <strong>
                <%= driver.current_status_i18n %>
            </strong>
            </div>

            <div class="driver-info-row">
            <span>Przypisano</span>
            <strong><%= l(current_assignment.updated_at, format: :long) %></strong>
            </div>
        <% else %>
            <div class="text-muted fst-italic">
            Pojazd nie ma przypisanego kierowcy
            </div>
        <% end %>

        </div>



    <!-- Dostępność pojazdu -->
    <div class="card shadow-sm rounded-4 p-4 mb-4 driver-section-card">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="section-title">
        <i class="bi bi-calendar2-check me-2"></i>Dostępność pojazdu
        </h6>

        <%= link_to new_dispatcher_availability_path(
            availableable_id: @vehicle.id,
            availableable_type: "Vehicle"
            ),
            class: "btn btn-sm btn-light border" do %>
        <i class="bi bi-plus-lg me-1"></i> Dodaj
        <% end %>
    </div>

    <% if @vehicle.availabilities.any? %>
        <div class="availability-list">

        <% @vehicle.availabilities
            .sort_by(&:start_time).reverse
            .group_by { |a| l(a.start_time, format: "%B %Y") }
            .each do |month, avails| %>

            <div class="month-separator">
            <span><%= month.capitalize %></span>
            </div>

            <% avails.each do |availability| %>
            <div class="availability-row">
                <div>
                <strong><%= l(availability.start_time, format: :long) %></strong>
                <div class="text-muted small">do</div>
                <strong><%= l(availability.end_time, format: :long) %></strong>
                </div>

                <div class="d-flex gap-2">
                <%= link_to edit_dispatcher_availability_path(
                        availability,
                        availableable_id: @vehicle.id,
                        availableable_type: "Vehicle"
                    ),
                    class: "btn btn-sm btn-light border" do %>
                    <i class="bi bi-pencil"></i>
                <% end %>

                <%= link_to dispatcher_availability_path(
                        availability,
                        availableable_id: @vehicle.id,
                        availableable_type: "Vehicle"
                    ),
                    data: { turbo_method: :delete, turbo_confirm: "Usunąć dostępność?" },
                    class: "btn btn-sm btn-light border" do %>
                    <i class="bi bi-trash"></i>
                <% end %>
                </div>
            </div>
            <% end %>

        <% end %>
        </div>
    <% else %>
        <div class="text-muted fst-italic">Brak dostępności</div>
    <% end %>

    </div>


        <!-- Aktualne zamówienia pojazdu -->
        <div class="card shadow-sm rounded-4 p-4 mt-4"
            data-controller="orders-search">

            <h5 class="mb-3 border-bottom pb-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-truck me-2"></i>Przypisane zamówienia</span>
            </h5>

            <!-- 🔎 Wyszukiwarka -->
            <div class="card p-2 mb-3 shadow-sm">
                <input type="text"
                    class="form-control"
                    placeholder="Szukaj w zamówieniach tego pojazdu..."
                    data-orders-search-target="input"
                    data-action="input->orders-search#filter">
            </div>

            <% current_orders = @vehicle.current_orders.sort_by(&:pickup_date).reverse %>

            <% if current_orders.any? %>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="pastel-thead">
                        <tr>
                            <th>Status</th>
                            <th>Data zał-roz</th>
                            <th>Miejsce zał-roz</th>
                            <th>Usługa</th>
                            <th>Nr zamówienia</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>

                    <tbody data-orders-search-target="rows">

                        <% grouped = current_orders.group_by { |o| I18n.l(o.pickup_date.to_date, format: :long) } %>

                        <% grouped.each do |day, orders| %>

                        <!-- 🔵 DZIENNY SEPARATOR -->
                        <tr class="day-separator-row">
                            <td colspan="6">
                                <div class="day-separator text-start fw-bold text-dark">
                                    <span><%= day %></span>
                                </div>
                            </td>
                        </tr>

                        <% orders.each do |order| %>
                        <tr>
                            <td>
                                <span class="badge status-badge <%= order.current_status %> rounded-pill px-3 py-2 fw-semibold">
                                    <%= order.status_name %>
                                </span>
                            </td>

                            <td>
                                <%= l(order.pickup_date, format: :short) %> -
                                <%= l(order.delivery_date, format: :short) %>
                            </td>

                            <td>
                                <%= order.pickup_place %> - <%= order.delivery_place %>
                            </td>

                            <td><%= order.service_type.name %></td>

                            <td class="fw-bold text-dark"><%= order.order_number %></td>

                            <td>
                                <%= link_to dispatcher_order_path(order),
                                    class: "btn btn-icon btn-pastel-secondary shadow-sm rounded-circle",
                                    title: "Szczegóły" do %>
                                    <i class="bi bi-gear"></i>
                                <% end %>
                            </td>
                        </tr>
                        <% end %>

                        <% end %>

                    </tbody>
                </table>
            </div>
            <% else %>
                <p class="text-muted">Brak aktualnych zamówień przypisanych do tego pojazdu.</p>
            <% end %>
        </div>



    <!-- Powrót -->
    <div class="mt-3">
        <%= link_to dispatcher_vehicles_path, class: "ios-back-btn ios-btn-back" do %>
        <i class="bi bi-arrow-left me-2"></i> Powrót do listy
        <% end %>
    </div>

</div>