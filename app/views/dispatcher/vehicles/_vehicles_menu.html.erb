<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
  <div class="d-flex flex-wrap gap-2">

    <!-- Home -->
    <%= link_to dispatcher_vehicles_path,
      class: "btn d-flex align-items-center shadow-sm rounded-pill px-3 py-2 border bg-gray text-dark" do %>
      <i class="bi bi-house-door-fill me-2 fs-5"></i>
    <% end %>

    <!-- Add vehicle -->
    <%= link_to new_dispatcher_vehicle_path,
      class: "btn d-flex align-items-center shadow-sm rounded-pill px-3 py-2 border bg-gray text-dark" do %>
      <i class="bi bi-person-plus-fill me-2 fs-5"></i>
      <span class="fw-semibold">Dodaj</span>
    <% end %>

    <% dashboard_cards = [
      { title: "Wszystkie",   path: all_vehicles_dispatcher_vehicles_path,       icon: "bi-people-fill",       color: "blue" },
      { title: "Dostępne",    path: available_vehicles_dispatcher_vehicles_path, icon: "bi-check-circle-fill", color: "green" },
      { title: "Niedostępne", path: unavailable_vehicles_dispatcher_vehicles_path, icon: "bi-x-circle-fill",    color: "pink" }
    ] %>

    <% dashboard_cards.each do |card| %>
      <%= link_to card[:path],
        class: "btn d-flex align-items-center shadow-sm rounded-pill px-3 py-2 border bg-#{card[:color]} text-dark" do %>
        <i class="bi <%= card[:icon] %> me-2 fs-5"></i>
        <span class="fw-semibold"><%= card[:title] %></span>
      <% end %>
    <% end %>

  </div>
</div>
