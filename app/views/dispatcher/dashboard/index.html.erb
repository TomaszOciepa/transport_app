<div class="container-fluid py-5 dispatcher-dashboard">
  <h2 class="dispatcher-dashboard-title text-center fw-bold mb-5">
    🚀 Panel dyspozytora
  </h2>

  <div class="d-flex flex-wrap justify-content-center gap-4">
    <% dashboard_cards = [
      { title: "Zamówienia", path: dispatcher_orders_path, icon: "bi-box-seam", color: "blue" },
      { title: "Pojazdy", path: dispatcher_vehicles_path, icon: "bi-truck", color: "green" },
      { title: "Kierowcy", path: dispatcher_drivers_path, icon: "bi-person-circle", color: "yellow" },
      { title: "Wiadomości", path: dispatcher_messages_path, icon: "bi-chat-dots-fill", color: "mint" },
      { title: "Kalendarz", path: dispatcher_calendar_path, icon: "bi-calendar-event", color: "pink" },
      { title: "Powiadomienia", path: dispatcher_notifications_path, icon: "bi-bell-fill", color: "purple" }
    ] %>

    <% dashboard_cards.each do |card| %>
      <%= link_to card[:path],
        class: "menu-card dashboard-card bg-#{card[:color]} text-center d-flex flex-column align-items-center justify-content-center rounded-4 shadow-sm text-decoration-none fw-bold" do %>

        <i class="bi <%= card[:icon] %> dashboard-card__icon mb-2"></i>
        <span class="dashboard-card__title"><%= card[:title] %></span>

      <% end %>
    <% end %>
  </div>
</div>
