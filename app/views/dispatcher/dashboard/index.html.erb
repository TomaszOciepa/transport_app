<div class="container-fluid py-5">
    <h2 class="fw-bold mb-5 text-center" style="color: #2c2c2c; font-size: 2rem; letter-spacing: 0.5px;">
        🚀 Panel dyspozytora
    </h2>

    <div class="d-flex flex-wrap justify-content-center gap-4">
        <% dashboard_cards = [
      { title: "Zamówienia", path: dispatcher_orders_path, icon: "bi-box-seam", color: "#A3CEF1" },
      { title: "Pojazdy", path: dispatcher_vehicles_path, icon: "bi-truck", color: "#B5EAD7" },
      { title: "Kierowcy", path: dispatcher_drivers_path, icon: "bi-person-circle", color: "#FFD6A5" },
      { title: "Kalendarz", path: dispatcher_calendar_path, icon: "bi-calendar-event", color: "#FFB7B2" },
      { title: "Powiadomienia", path: dispatcher_notifications_path, icon: "bi-bell-fill", color: "#E2C1F0" }
    ] %>

        <% dashboard_cards.each do |card| %>
        <%= link_to card[:path], class: "menu-card text-center d-flex flex-column align-items-center justify-content-center rounded-4 shadow-sm text-decoration-none fw-bold", 
                  style: "width: 150px; height: 130px; background-color: #{card[:color]}; transition: all 0.2s ease;" do %>
        <i class="bi <%= card[:icon] %> fs-2 text-dark mb-2"></i>
        <span style="color: #2c2c2c; font-size: 1rem;"><%= card[:title] %></span>
        <% end %>
        <% end %>
    </div>
</div>