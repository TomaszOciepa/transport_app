<%
  whatsapp_session    ||= nil
  conversations       ||= []
  active_conversation ||= nil
  messages            ||= []
%>


<% if whatsapp_session&.status == "ready" %>

  <div class="whatsapp-layout">

    <%= render "conversations/list",
          conversations: conversations,
          user_id: whatsapp_session.user_id,
          autofocus_first: params[:conversation_id].blank? %>

    <turbo-frame id="chat">
        <%= render "conversations/chat",
              conversation: active_conversation,
              messages: messages %>
    </turbo-frame>
  </div>

<% end %>
