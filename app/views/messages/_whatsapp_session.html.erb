<div id="whatsapp_session" class="whatsapp-session">

  <% if whatsapp_session.nil? || whatsapp_session.status == "disconnected" %>

    <div class="whatsapp-login">

      <div class="whatsapp-login-header">
        <h2>Połącz WhatsApp</h2>
        <p>
          Połącz swoje konto z aplikacją WhatsApp, aby wysyłać i odbierać wiadomości.
        </p>
      </div>

      <div class="whatsapp-login-content">

        <div class="whatsapp-login-instructions">
          <ol>
            <li>Otwórz aplikację <strong>WhatsApp</strong> na swoim telefonie.</li>
            <li>Przejdź do <strong>Ustawienia → Połączone urządzenia</strong>.</li>
            <li>Kliknij <strong>Połącz urządzenie</strong> i zeskanuj kod QR.</li>
          </ol>

          <p class="whatsapp-login-note">
            ⚠️ Użyj aplikacji WhatsApp powiązanej z Twoim numerem służbowym.
          </p>
        </div>

        <div class="whatsapp-login-action">
          <%= button_to "Połącz",
                connect_messages_path,
                method: :post,
                class: "whatsapp-button whatsapp-button-primary whatsapp-button-large" %>
        </div>

      </div>
    </div>

  <% elsif whatsapp_session.status == "pending" %>

    <div class="whatsapp-login">

      <div class="whatsapp-login-header">
        <h2>Połącz WhatsApp</h2>
        <p>Zeskanuj kod QR w aplikacji WhatsApp.</p>
      </div>

      <div class="whatsapp-login-content">

        <div class="whatsapp-login-instructions">
          <ol>
            <li>Otwórz aplikację <strong>WhatsApp</strong> na swoim telefonie.</li>
            <li>Przejdź do <strong>Ustawienia → Połączone urządzenia</strong>.</li>
            <li>Kliknij <strong>Połącz urządzenie</strong> i zeskanuj kod QR.</li>
          </ol>

          <p class="whatsapp-login-note">
            ⚠️ Skanuj kod aplikacją WhatsApp powiązaną z Twoim numerem.
          </p>
        </div>

        <div class="whatsapp-login-qr">
          <% if whatsapp_session.qr_code.present? %>
            <%= image_tag(
              "https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=#{CGI.escape(whatsapp_session.qr_code)}",
              class: "whatsapp-session-qr-image"
            ) %>
          <% else %>
            <div class="whatsapp-session-pending">
              <div class="whatsapp-spinner"></div>
              <p>Generowanie kodu QR…</p>
            </div>
          <% end %>
        </div>

      </div>
    </div>

    <% elsif whatsapp_session.status == "invalid_phone" %>

    <div class="whatsapp-login whatsapp-login-error">
  
      <div class="whatsapp-login-header">
        <h2>❌ Nieprawidłowy numer WhatsApp</h2>
        <p>
          Połączenie nie mogło zostać ustanowione.
        </p>
      </div>
  
      <div class="whatsapp-login-content">
  
        <div class="whatsapp-login-instructions">
          <p class="whatsapp-session-text">
            Zeskanowałeś kod QR aplikacją WhatsApp, która <strong>nie jest powiązana</strong>
            z Twoim kontem służbowym.
          </p>
  
          <p class="whatsapp-session-text">
            Użyj aplikacji WhatsApp powiązanej z numerem:
          </p>
  
          <p class="whatsapp-session-phone whatsapp-session-phone-error">
            <strong><%= whatsapp_session.user.phone %></strong>
          </p>
  
          <p class="whatsapp-login-note">
            ⚠️ Jeśli nie masz dostępu do tego numeru, skontaktuj się z administratorem.
          </p>
        </div>
  
        <div class="whatsapp-login-action">
          <%= button_to "Spróbuj ponownie",
                connect_messages_path,
                method: :post,
                class: "whatsapp-button whatsapp-button-primary whatsapp-button-large" %>
        </div>
  
      </div>
    </div>
  

      <% elsif whatsapp_session.status == "ready" %>

  <div class="whatsapp-login whatsapp-login-ready whatsapp-session-ready"
       data-controller="whatsapp-session">

    <!-- HEADER (zawsze widoczny, niski) -->
    <div class="whatsapp-login-header whatsapp-session-ready-header"
         role="button"
         data-action="click->whatsapp-session#toggle">

      <h2>WhatsApp połączony</h2>
      <p>Połączenie zostało ustanowione pomyślnie.</p>

      <span class="whatsapp-session-ready-chevron"
            data-whatsapp-session-target="chevron">
        ▼
      </span>
    </div>

    <!-- CONTENT (zwijany) -->
    <div class="whatsapp-session-ready-content"
         data-whatsapp-session-target="content">

      <div class="whatsapp-login-instructions">
        <p class="whatsapp-session-text">
          Konto WhatsApp zostało poprawnie połączone z systemem.
        </p>

        <p class="whatsapp-session-text">
          Aktywny numer WhatsApp:
        </p>

        <p class="whatsapp-session-phone whatsapp-session-phone-ready">
          <strong><%= whatsapp_session.phone %></strong>
        </p>
      </div>

      <div class="whatsapp-login-action">
        <%= button_to "Rozłącz WhatsApp",
              disconnect_messages_path,
              method: :post,
              class: "whatsapp-button whatsapp-button-danger whatsapp-button-large" %>
      </div>

    </div>
  </div>

<% end %>

  

</div>
