<div class="container-fluid py-5">
    <h2 class="fw-bold mb-5 text-center" style="color: #2c2c2c; font-size: 2rem;">
        Panel klienta
    </h2>

    <% client_cards = [
    { title: "Zamówienia", path: client_orders_path, icon: "bi-box-seam", color: "#A3CEF1", description: "Zarządzaj zamówieniami transportu." },
    { title: "Kalendarz", path: client_calendar_path, icon: "bi-calendar-event", color: "#FFB7B2", description: "Terminy zamówień i dyspozycji." },
    { title: "Powiadomienia", path: client_notifications_path, icon: "bi-bell-fill", color: "#E2C1F0", description: "Powiadomienia i statusy zamówień." }
  ] %>

    <div class="row g-4 justify-content-center">
        <% client_cards.each do |card| %>
        <div class="col-sm-6 col-md-4">
            <div class="card pastel-card shadow-sm rounded-4 h-100 text-center" style="--card-color: <%= card[:color] %>;">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="icon-wrapper mx-auto mb-3" style="background-color: var(--card-color);">
                            <i class="bi <%= card[:icon] %> fs-2 text-white"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="color: #2c2c2c;"><%= card[:title] %></h5>
                        <p class="text-muted small mb-0"><%= card[:description] %></p>
                    </div>
                    <%= link_to "Przejdź", card[:path], class: "btn btn-dark rounded-pill mt-3 fw-bold shadow-sm" %>
                </div>
            </div>
        </div>
        <% end %>
    </div>
</div>