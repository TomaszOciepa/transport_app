<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Lista zamówień</h2>

    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><%= sortable "status", "Status" %></th>
                    <th><%= sortable "pickup_date", "Data załadunku" %></th>
                    <th><%= sortable "delivery_date", "Data dostawy" %></th>
                    <th><%= sortable "service_type_id", "Usługa" %></th>
                    <th><%= sortable "order_number", "Nr zamówienia" %></th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                <% @orders.each do |order| %>
                <tr class="align-middle">
                    <td>
                        <% status = order.current_status %>
                        <span class="badge status-badge <%= status %> rounded-pill px-3 py-1">
                            <%= order.status_name %>
                        </span>
                    </td>
                    <td><%= l(order.pickup_date, format: :short) if order.pickup_date %></td>
                    <td><%= l(order.delivery_date, format: :short) if order.delivery_date %></td>
                    <td><%= order.service_type.name %></td>
                    <td class="fw-bold"><%= order.order_number %></td>
                    <td>

                        <%= link_to client_order_path(order),
                            class: "btn btn-icon btn-pastel-secondary shadow-sm rounded-circle",
                            title: "Szczegóły" do %>
                        <i class="bi bi-gear"></i>
                        <% end %>

                        <%= link_to client_order_path(order),
                            data: { turbo_method: :delete, turbo_confirm: "Czy na pewno chcesz usunąć to zamówienie?" },
                            class: "btn btn-icon btn-pastel-danger shadow-sm rounded-circle",
                            title: "Usuń" do %>
                        <i class="bi bi-trash"></i>
                        <% end %>
                    </td>
                </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>