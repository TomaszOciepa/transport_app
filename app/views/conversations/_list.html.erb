<div class="whatsapp-sidebar">

  <% if conversations.present? %>

    <% conversations.each do |conversation| %>
      <div class="whatsapp-conversation">

        <div class="whatsapp-conversation-title">
          <%= conversation.whatsapp_chat_id %>
        </div>

        <div class="whatsapp-conversation-meta">
          <%= conversation.last_message_at&.strftime("%H:%M %d.%m") %>
        </div>

      </div>
    <% end %>

  <% else %>

    <div class="whatsapp-conversation-empty">
      Brak rozmów
    </div>

  <% end %>

</div>
