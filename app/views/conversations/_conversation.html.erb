<%= link_to messages_path(conversation_id: conversation.id),
      data: {
        turbo_frame: "chat",
        turbo_prefetch: false,
        controller: "conversation",
        action: "click->conversation#select",
        conversation_id: conversation.id
      },
      class: "whatsapp-conversation",
      id: dom_id(conversation) do %>

  <div class="whatsapp-conversation-title d-flex justify-content-between align-items-center">
    <div class="whatsapp-conversation-name">
      <% if conversation.driver.present? %>
        <strong>
          <%= conversation.driver.first_name %> <%= conversation.driver.last_name %>
        </strong>
      <% else %>
        <%= conversation.whatsapp_chat_id %>
      <% end %>
    </div>

    <% if conversation.unread_count.to_i > 0 %>
      <span class="whatsapp-unread-badge">
        <%= conversation.unread_count %>
      </span>
    <% end %>
  </div>


<div class="whatsapp-conversation-meta">
  <div class="whatsapp-conversation-time">
    <%= conversation.last_message_at&.strftime("%H:%M %d.%m") %>
  </div>

  <div class="whatsapp-conversation-preview">
    <%= conversation.last_message_preview.presence || " " %>
  </div>
</div>



<% end %>
