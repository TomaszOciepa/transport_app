<div class="whatsapp-chat">

  <% if conversation.present? %>

    <!-- HEADER -->
    <div class="whatsapp-chat-header">
      <%= conversation.whatsapp_chat_id %>
    </div>

    <!-- MESSAGES -->
    <div class="whatsapp-chat-messages">

      <% messages.each do |message| %>
        <div class="whatsapp-message-row
          <%= message.direction == "outbound" ? "whatsapp-message-out" : "whatsapp-message-in" %>">

          <div class="whatsapp-message-bubble">
            <div class="whatsapp-message-body">
              <%= message.body %>
            </div>

            <div class="whatsapp-message-time">
              <%= message.sent_at&.strftime("%H:%M") %>
            </div>
          </div>

        </div>
      <% end %>

    </div>

    <!-- INPUT (later) -->
    <div class="whatsapp-chat-input">
      Message input (later)
    </div>

  <% else %>

    <div class="whatsapp-chat-empty">
      Select a conversation
    </div>

  <% end %>

</div>
