<div class="whatsapp-chat"  
    data-controller="chat file-preview" 
    data-conversation-id="<%= conversation.id if conversation %>">

  <% if conversation.present? %>

   <!-- HEADER -->
   <div class="whatsapp-chat-header d-flex justify-content-between align-items-center">

  <!-- LEWA STRONA: tytuł -->
  <div>
    <% if conversation.chat_type == "group" && conversation.order_id.present? %>

      <%= link_to dispatcher_order_path(conversation.order_id),
            class: "text-decoration-none text-dark",
            title: "Przejdź do zamówienia",
            data: { turbo: false } do %>

        <strong>
          <i class="bi bi-people me-1"></i>
          <%= conversation.group_name.presence || "Grupa WhatsApp" %>
        </strong>

      <% end %>

    <% elsif conversation.driver.present? %>

      <%= link_to dispatcher_driver_path(conversation.driver),
            class: "text-decoration-none text-dark",
            title: "Przejdź do kierowcy",
            data: { turbo: false } do %>

        <strong>
          <i class="bi bi-person me-1"></i>
          <%= conversation.driver.first_name %> <%= conversation.driver.last_name %>
        </strong>

      <% end %>

    <% else %>
      <strong><%= conversation.whatsapp_chat_id %></strong>
    <% end %>
  </div>

  <!-- PRAWA STRONA: przycisk (TYLKO DLA GRUPY) -->
  <% if conversation.chat_type == "group" && conversation.order_id.present? %>
    <%= button_to send_order_details_messages_path,
          method: :post,
          params: { conversation_id: conversation.id },
          class: "btn btn-sm btn-outline-primary",
          title: "Wyślij szczegóły zamówienia",
          data: { turbo: true } do %>

      <i class="bi bi-send"></i>

    <% end %>
  <% end %>

</div>




    <!-- MESSAGES -->
    <div
      class="whatsapp-chat-messages"
      id="whatsapp_messages_<%= conversation.id %>">

      <%= turbo_stream_from "whatsapp_messages_#{conversation.id}" %>

      <% unread_index = conversation.first_unread_message_index %>

      <% messages.each_with_index do |message, index| %>

        <% if unread_index && index == unread_index %>
          <%= render "conversations/new_messages_separator" %>
        <% end %>

        <%= render "conversations/message", message: message %>

      <% end %>

    </div>

     <!-- INPUT -->
    <div class="whatsapp-chat-input">

      <div id="whatsapp-file-preview" class="whatsapp-file-preview" hidden>
        <span id="whatsapp-file-name"></span>
        <button type="button" id="whatsapp-file-remove">✕</button>
      </div>


      <%= form_with url: send_message_messages_path,
            method: :post,
            html: { multipart: true },
            data: { turbo: true },
            class: "whatsapp-input-form" do |f| %>

        <%= hidden_field_tag :conversation_id, conversation.id %>

        <!-- IKONA PLUSA -->
        <label class="whatsapp-attach-btn">
          <i class="bi bi-plus-lg"></i>
          <%= f.file_field :file,
              id: "whatsapp_file_input",
              class: "d-none",
              accept: "image/*,application/pdf" %>
        </label>

        <!-- POLE TEKSTOWE -->
        <%= f.text_field :body,
              placeholder: "Napisz wiadomość...",
              class: "whatsapp-text-input",
              autocomplete: "off" %>

        <!-- WYŚLIJ -->
        <button type="submit" class="whatsapp-send-btn">
          <i class="bi bi-send-fill"></i>
        </button>

      <% end %>
    </div>


  <% else %>
    <div class="whatsapp-chat-empty">
      Select a conversation
    </div>
  <% end %>

</div>
