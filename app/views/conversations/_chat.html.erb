<div class="whatsapp-chat"  
    data-controller="chat" 
    data-conversation-id="<%= conversation.id if conversation %>">

  <% if conversation.present? %>

   <!-- HEADER -->
    <div class="whatsapp-chat-header">
      <% if conversation.driver.present? %>
        <strong>
          <%= conversation.driver.first_name %> <%= conversation.driver.last_name %>
        </strong>
      <% else %>
        <%= conversation.whatsapp_chat_id %>
      <% end %>
    </div>


    <!-- MESSAGES -->
    <div
      class="whatsapp-chat-messages"
      id="whatsapp_messages_<%= conversation.id %>">

      <%= turbo_stream_from "whatsapp_messages_#{conversation.id}" %>

      <% unread_index = conversation.first_unread_message_index %>

      <% messages.each_with_index do |message, index| %>

        <% if unread_index && index == unread_index %>
          <%= render "conversations/new_messages_separator" %>
        <% end %>

        <%= render "conversations/message", message: message %>

      <% end %>

    </div>

     <!-- INPUT -->
    <div class="whatsapp-chat-input">
      <%= form_with url: send_message_messages_path,
            method: :post,
            data: { turbo: true },
            class: "d-flex gap-2" do |f| %>

        <%= hidden_field_tag :conversation_id, conversation.id %>

        <%= f.text_field :body,
              placeholder: "Napisz wiadomość...",
              class: "form-control",
              autocomplete: "off" %>

        <%= f.submit "Wyślij", class: "btn btn-success" %>
      <% end %>
    </div>

  <% else %>
    <div class="whatsapp-chat-empty">
      Select a conversation
    </div>
  <% end %>

</div>
